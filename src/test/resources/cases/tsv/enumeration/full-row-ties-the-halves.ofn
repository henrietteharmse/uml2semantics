Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(ex:=<https://example.org/vocabulary/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # The name-only and the curie-only rows turn out to be one enumeration, so one class is written
  # and both values belong to it.
  Declaration(Class(ex:SalarySchedule))
  AnnotationAssertion(rdfs:label ex:SalarySchedule "PaymentSchedule")
  AnnotationAssertion(rdfs:comment ex:SalarySchedule "The frequency of payments.")
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/PaymentSchedule#Daily>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/PaymentSchedule#Daily> "Daily")
  ClassAssertion(ex:SalarySchedule <https://uml2semantics.com/test/ontology/PaymentSchedule#Daily>)
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly> "Weekly")
  ClassAssertion(ex:SalarySchedule <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>)
  EquivalentClasses(ex:SalarySchedule ObjectOneOf(<https://uml2semantics.com/test/ontology/PaymentSchedule#Daily> <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>))
  DifferentIndividuals(<https://uml2semantics.com/test/ontology/PaymentSchedule#Daily> <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>)
)
