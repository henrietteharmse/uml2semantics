Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # Enumerations join the global disjointness axiom alongside the root classes: a value is never an
  # instance of a class, and belongs to one enumeration.
  Declaration(Class(:Person))
  AnnotationAssertion(rdfs:label :Person "Person")
  AnnotationAssertion(rdfs:comment :Person "A human being.")
  Declaration(Class(:Organisation))
  AnnotationAssertion(rdfs:label :Organisation "Organisation")
  AnnotationAssertion(rdfs:comment :Organisation "A body of people.")
  Declaration(Class(:PaymentSchedule))
  AnnotationAssertion(rdfs:label :PaymentSchedule "PaymentSchedule")
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/PaymentSchedule#Daily>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/PaymentSchedule#Daily> "Daily")
  ClassAssertion(:PaymentSchedule <https://uml2semantics.com/test/ontology/PaymentSchedule#Daily>)
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly> "Weekly")
  ClassAssertion(:PaymentSchedule <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>)
  EquivalentClasses(:PaymentSchedule ObjectOneOf(<https://uml2semantics.com/test/ontology/PaymentSchedule#Daily> <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>))
  DifferentIndividuals(<https://uml2semantics.com/test/ontology/PaymentSchedule#Daily> <https://uml2semantics.com/test/ontology/PaymentSchedule#Weekly>)
  Declaration(Class(:ContractType))
  AnnotationAssertion(rdfs:label :ContractType "ContractType")
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/ContractType#Permanent>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/ContractType#Permanent> "Permanent")
  ClassAssertion(:ContractType <https://uml2semantics.com/test/ontology/ContractType#Permanent>)
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/ContractType#Temporary>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/ContractType#Temporary> "Temporary")
  ClassAssertion(:ContractType <https://uml2semantics.com/test/ontology/ContractType#Temporary>)
  EquivalentClasses(:ContractType ObjectOneOf(<https://uml2semantics.com/test/ontology/ContractType#Permanent> <https://uml2semantics.com/test/ontology/ContractType#Temporary>))
  DifferentIndividuals(<https://uml2semantics.com/test/ontology/ContractType#Permanent> <https://uml2semantics.com/test/ontology/ContractType#Temporary>)
  DisjointClasses(:Person :Organisation :PaymentSchedule :ContractType)
)
