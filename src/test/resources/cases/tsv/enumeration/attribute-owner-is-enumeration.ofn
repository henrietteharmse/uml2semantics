Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # The attribute row naming Colour as its class was rejected, so Colour is only an enumeration: it
  # gains no property and is not also built as a UML class.
  Declaration(Class(:Person))
  AnnotationAssertion(rdfs:label :Person "Person")
  AnnotationAssertion(rdfs:comment :Person "A human being.")
  Declaration(DataProperty(<https://uml2semantics.com/test/ontology/Person#name>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Person#name> "name")
  DataPropertyDomain(<https://uml2semantics.com/test/ontology/Person#name> :Person)
  DataPropertyRange(<https://uml2semantics.com/test/ontology/Person#name> xsd:string)
  SubClassOf(:Person DataExactCardinality(1 <https://uml2semantics.com/test/ontology/Person#name> xsd:string))
  Declaration(Class(:Colour))
  AnnotationAssertion(rdfs:label :Colour "Colour")
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/Colour#Red>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Colour#Red> "Red")
  ClassAssertion(:Colour <https://uml2semantics.com/test/ontology/Colour#Red>)
  EquivalentClasses(:Colour ObjectOneOf(<https://uml2semantics.com/test/ontology/Colour#Red>))
  DisjointClasses(:Person :Colour)
)
