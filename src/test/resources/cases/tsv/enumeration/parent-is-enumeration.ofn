Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # Colour was built on the fly as the parent of Shade, so it is a class and the enumeration of the
  # same name was rejected. Shade has a parent and stays out of global disjointness; Colour and the
  # enumeration Size are roots.
  Declaration(Class(:Shade))
  AnnotationAssertion(rdfs:label :Shade "Shade")
  AnnotationAssertion(rdfs:comment :Shade "A lighter or darker variant.")
  Declaration(Class(:Colour))
  AnnotationAssertion(rdfs:label :Colour "Colour")
  SubClassOf(:Shade :Colour)
  Declaration(Class(:Size))
  AnnotationAssertion(rdfs:label :Size "Size")
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/Size#Small>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Size#Small> "Small")
  ClassAssertion(:Size <https://uml2semantics.com/test/ontology/Size#Small>)
  EquivalentClasses(:Size ObjectOneOf(<https://uml2semantics.com/test/ontology/Size#Small>))
  DisjointClasses(:Colour :Size)
)
