Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # A prefix IRI ending in neither / nor # has a / inserted before the class name, and the
  # attribute is separated from its class label by #.
  Declaration(Class(<https://uml2semantics.com/test/ontology/Person>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Person> "Person")
  AnnotationAssertion(rdfs:comment <https://uml2semantics.com/test/ontology/Person> "A human being.")
  Declaration(DataProperty(<https://uml2semantics.com/test/ontology/Person#name>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Person#name> "name")
  AnnotationAssertion(rdfs:comment <https://uml2semantics.com/test/ontology/Person#name> "The name of a person.")
  DataPropertyDomain(<https://uml2semantics.com/test/ontology/Person#name> <https://uml2semantics.com/test/ontology/Person>)
  DataPropertyRange(<https://uml2semantics.com/test/ontology/Person#name> xsd:string)
  SubClassOf(<https://uml2semantics.com/test/ontology/Person> DataExactCardinality(1 <https://uml2semantics.com/test/ontology/Person#name> xsd:string))
)
