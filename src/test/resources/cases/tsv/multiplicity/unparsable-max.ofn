Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # The unparsable max warns and falls back to 1, which then sits below the explicit min of 2.
  # That pair is unusable, so no restriction is asserted — but the attribute is kept rather than
  # being lost to a single bad cell.
  Declaration(Class(:Person))
  AnnotationAssertion(rdfs:label :Person "Person")
  AnnotationAssertion(rdfs:comment :Person "A human being.")
  Declaration(DataProperty(<https://uml2semantics.com/test/ontology/Person#value>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Person#value> "value")
  AnnotationAssertion(rdfs:comment <https://uml2semantics.com/test/ontology/Person#value> "A value of a person.")
  DataPropertyDomain(<https://uml2semantics.com/test/ontology/Person#value> :Person)
  DataPropertyRange(<https://uml2semantics.com/test/ontology/Person#value> xsd:string)
)
