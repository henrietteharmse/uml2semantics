Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # Only children are excluded from the global axiom. Person owns a generalization set but is
  # still declared disjoint from Address, while its child Employee is left out.
  Declaration(Class(:Person))
  AnnotationAssertion(rdfs:label :Person "Person")
  AnnotationAssertion(rdfs:comment :Person "A human being.")
  Declaration(Class(:Employee))
  AnnotationAssertion(rdfs:label :Employee "Employee")
  AnnotationAssertion(rdfs:comment :Employee "A person who does work.")
  Declaration(Class(:Address))
  AnnotationAssertion(rdfs:label :Address "Address")
  AnnotationAssertion(rdfs:comment :Address "Where something is located.")
  SubClassOf(:Employee :Person)
  DisjointClasses(:Person :Address)
)
