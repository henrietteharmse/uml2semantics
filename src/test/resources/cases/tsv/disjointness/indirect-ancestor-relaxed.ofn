Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # A shared descendant, not a shared child. Dog inherits from Mammal and Pet, but Mammal is not a
  # root, so the two roots that would have been declared disjoint are Animal and Pet — and Animal
  # is Dog's grandparent. Both are dropped; Address and Country, which share nothing with Dog,
  # keep their disjointness.
  Declaration(Class(:Animal))
  AnnotationAssertion(rdfs:label :Animal "Animal")
  AnnotationAssertion(rdfs:comment :Animal "A living creature.")
  Declaration(Class(:Mammal))
  AnnotationAssertion(rdfs:label :Mammal "Mammal")
  AnnotationAssertion(rdfs:comment :Mammal "An animal that suckles its young.")
  Declaration(Class(:Pet))
  AnnotationAssertion(rdfs:label :Pet "Pet")
  AnnotationAssertion(rdfs:comment :Pet "An animal kept for company.")
  Declaration(Class(:Dog))
  AnnotationAssertion(rdfs:label :Dog "Dog")
  AnnotationAssertion(rdfs:comment :Dog "A domesticated canine.")
  Declaration(Class(:Address))
  AnnotationAssertion(rdfs:label :Address "Address")
  AnnotationAssertion(rdfs:comment :Address "Where something is located.")
  Declaration(Class(:Country))
  AnnotationAssertion(rdfs:label :Country "Country")
  AnnotationAssertion(rdfs:comment :Country "A sovereign state.")
  SubClassOf(:Mammal :Animal)
  SubClassOf(:Dog :Mammal)
  SubClassOf(:Dog :Pet)
  DisjointClasses(:Address :Country)
)
