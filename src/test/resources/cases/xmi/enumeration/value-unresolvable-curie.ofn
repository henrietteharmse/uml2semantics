Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # The value with the unresolvable curie is rejected. Its enumeration and the other value are kept.
  Declaration(Class(:Size))
  AnnotationAssertion(rdfs:label :Size "Size")
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/Size#Large>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Size#Large> "Large")
  ClassAssertion(:Size <https://uml2semantics.com/test/ontology/Size#Large>)
  EquivalentClasses(:Size ObjectOneOf(<https://uml2semantics.com/test/ontology/Size#Large>))
)
