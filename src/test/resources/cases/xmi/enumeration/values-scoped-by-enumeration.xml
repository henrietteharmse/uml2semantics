<?xml version="1.0" encoding="UTF-8"?>
<!--
	Rule 3. Two enumerations that both have a literal named Other.
-->
<xmi:XMI xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1">
	<xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
	<uml:Model xmi:type="uml:Model" name="EA_Model" visibility="public">
		<packagedElement xmi:type="uml:Package" xmi:id="EAPK_Model" name="Model" visibility="public">
			<packagedElement xmi:type="uml:Enumeration" xmi:id="EAID_PaymentSchedule" name="PaymentSchedule" visibility="public">
				<ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_PaymentSchedule_Weekly" name="Weekly" visibility="public"/>
				<ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_PaymentSchedule_Other" name="Other" visibility="public"/>
			</packagedElement>
			<packagedElement xmi:type="uml:Enumeration" xmi:id="EAID_ContractType" name="ContractType" visibility="public">
				<ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_ContractType_Permanent" name="Permanent" visibility="public"/>
				<ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_ContractType_Other" name="Other" visibility="public"/>
			</packagedElement>
		</packagedElement>
	</uml:Model>
</xmi:XMI>
