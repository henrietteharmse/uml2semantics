Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # The shared namespace holds across sources. TSV is read second, so its class row for Colour is
  # rejected and Colour stays the enumeration, without the definition of the rejected row.
  Declaration(Class(:Colour))
  AnnotationAssertion(rdfs:label :Colour "Colour")
  Declaration(NamedIndividual(<https://uml2semantics.com/test/ontology/Colour#Red>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Colour#Red> "Red")
  ClassAssertion(:Colour <https://uml2semantics.com/test/ontology/Colour#Red>)
  EquivalentClasses(:Colour ObjectOneOf(<https://uml2semantics.com/test/ontology/Colour#Red>))
  Declaration(Class(:Person))
  AnnotationAssertion(rdfs:label :Person "Person")
  AnnotationAssertion(rdfs:comment :Person "A human being.")
  DisjointClasses(:Person :Colour)
)
