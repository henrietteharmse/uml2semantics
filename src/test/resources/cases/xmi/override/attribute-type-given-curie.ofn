Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(ex:=<https://example.org/vocabulary/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # The same for an attribute drawn in the class: the range of its property follows the class that is
  # its type to the IRI the curie gives.
  Declaration(Class(:Employer))
  AnnotationAssertion(rdfs:label :Employer "Employer")
  Declaration(Class(ex:Employee))
  AnnotationAssertion(rdfs:label ex:Employee "Employee")
  Declaration(ObjectProperty(<https://uml2semantics.com/test/ontology/Employer#employs>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Employer#employs> "employs")
  ObjectPropertyDomain(<https://uml2semantics.com/test/ontology/Employer#employs> :Employer)
  ObjectPropertyRange(<https://uml2semantics.com/test/ontology/Employer#employs> ex:Employee)
  SubClassOf(:Employer ObjectExactCardinality(1 <https://uml2semantics.com/test/ontology/Employer#employs> owl:Thing))
  DisjointClasses(:Employer ex:Employee)
)
