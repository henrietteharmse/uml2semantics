Prefix(:=<https://uml2semantics.com/test/ontology/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://uml2semantics.com/test/ontology>

  # n is [n,n], m..n is [m,n] and * is [0,*]. Each is then translated as the multiplicity of any object
  # property: an exact cardinality, a max only, no restriction, and a min with a max.
  Declaration(Class(:Order))
  AnnotationAssertion(rdfs:label :Order "Order")
  Declaration(Class(:Item))
  AnnotationAssertion(rdfs:label :Item "Item")
  Declaration(ObjectProperty(<https://uml2semantics.com/test/ontology/Order#exactlyTwo>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Order#exactlyTwo> "exactlyTwo")
  ObjectPropertyDomain(<https://uml2semantics.com/test/ontology/Order#exactlyTwo> :Order)
  ObjectPropertyRange(<https://uml2semantics.com/test/ontology/Order#exactlyTwo> :Item)
  SubClassOf(:Order ObjectExactCardinality(2 <https://uml2semantics.com/test/ontology/Order#exactlyTwo> owl:Thing))
  Declaration(ObjectProperty(<https://uml2semantics.com/test/ontology/Order#upToThree>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Order#upToThree> "upToThree")
  ObjectPropertyDomain(<https://uml2semantics.com/test/ontology/Order#upToThree> :Order)
  ObjectPropertyRange(<https://uml2semantics.com/test/ontology/Order#upToThree> :Item)
  SubClassOf(:Order ObjectMaxCardinality(3 <https://uml2semantics.com/test/ontology/Order#upToThree> owl:Thing))
  Declaration(ObjectProperty(<https://uml2semantics.com/test/ontology/Order#anyNumber>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Order#anyNumber> "anyNumber")
  ObjectPropertyDomain(<https://uml2semantics.com/test/ontology/Order#anyNumber> :Order)
  ObjectPropertyRange(<https://uml2semantics.com/test/ontology/Order#anyNumber> :Item)
  Declaration(ObjectProperty(<https://uml2semantics.com/test/ontology/Order#oneToFive>))
  AnnotationAssertion(rdfs:label <https://uml2semantics.com/test/ontology/Order#oneToFive> "oneToFive")
  ObjectPropertyDomain(<https://uml2semantics.com/test/ontology/Order#oneToFive> :Order)
  ObjectPropertyRange(<https://uml2semantics.com/test/ontology/Order#oneToFive> :Item)
  SubClassOf(:Order ObjectIntersectionOf(ObjectMinCardinality(1 <https://uml2semantics.com/test/ontology/Order#oneToFive> owl:Thing) ObjectMaxCardinality(5 <https://uml2semantics.com/test/ontology/Order#oneToFive> owl:Thing)))
  DisjointClasses(:Order :Item)
)
