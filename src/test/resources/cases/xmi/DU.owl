        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Oertlichkeit_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Betriebsstelle(n) (Örtlichkeiten), denen das Segment Profil zugeordnet ist. Aus der Zuordnung lässt sich der Zuständigkeitsbereich einer ATO-TS-Instanz ableiten.&quot;}</rdfs:comment>
        <rdfs:label>ID_Oertlichkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CATO_Segment_Profile_Bezeichnung#NID_SP -->


