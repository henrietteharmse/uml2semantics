        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CPruefmerkmale_Daten"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Prüfmerkmale der Binärdaten (z. B. Prüfsumme, Version), die von der Balise gesendet werden.&quot;}</rdfs:comment>
        <rdfs:label>Pruefmerkmale_Binaerdaten</rdfs:label>
    </owl:ObjectProperty>
    


