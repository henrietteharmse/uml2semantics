        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPrioritaet"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[1..15]&quot;,&quot;Documentation&quot;:&quot;Bei mehreren Anwendungssystemen in Sonderfällen (z. B. ausländische Anwendungssysteme): Priorität für die Nutzung.&quot;}</rdfs:comment>
        <rdfs:label>Prioritaet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Nach_L2#Abstand_Grenze_Bereich_C -->


