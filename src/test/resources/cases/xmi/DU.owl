        <rdfs:comment>{&quot;Documentation&quot;:&quot;Rechtliche Klassifizierung der Strecke (Haupt-/Nebenbahn). DB-Regelwerk Angabe auf dem LP&quot;}</rdfs:comment>
        <rdfs:label>Strecke_Art</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBlock_Strecke_Allg#Streckengeschwindigkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBlock_Strecke_Allg#Streckengeschwindigkeit">
