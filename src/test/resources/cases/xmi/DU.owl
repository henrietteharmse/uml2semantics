        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDaten"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Im base64-Format codierter Inhalt der Binaerdaten bzw. -datei.&quot;}</rdfs:comment>
        <rdfs:label>Daten</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBinaerdaten_Datei#Dateiname -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBinaerdaten_Datei#Dateiname">
