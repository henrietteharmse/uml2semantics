        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCWirkrichtung_In_Datenpunkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Richtung der betrieblichen Funktion in Bezug auf die physikalische oder durch Linking vorgegebene Ausrichtung des Datenpunkts. Der Wert \&quot;in\&quot; ist mit \&quot;nominal\&quot; gleichzusetzen, der Wert \&quot;gegen\&quot; mit \&quot;reverse\&quot;.&quot;}</rdfs:comment>
        <rdfs:label>Wirkrichtung_In_Datenpunkt</rdfs:label>
    </owl:ObjectProperty>
    


