        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBez_ZUB_Bereichsgrenze"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bezeichnung der Bereichsgrenze (Ein-/Ausstiegspunkt), z. B. \&quot;Einstieg in Richtung Gleise 7-14\&quot;. Die Angabe ist bei Ein-/Ausstieg L2 Pflicht.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..50]&quot;}</rdfs:comment>
        <rdfs:label>Bez_ZUB_Bereichsgrenze</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Nach_ESG#Bgrenze_Nach_ESG_Bed_Ausstieg -->


