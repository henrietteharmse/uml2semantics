    <!-- https://uml2semantics.com/ontology/CATO_Segment_Profile#Abstand_ATO_Halt_Vor_EoA -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CATO_Segment_Profile#Abstand_ATO_Halt_Vor_EoA">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CATO_Segment_Profile"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAbstand_ATO_Halt_Vor_EoA"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Distanz vor dem eigentlichen Punkt der End of Authority (EoA) der relevanten ETCS MA, auf die ATO-OB den automatisch geführten Zug hin bremst. Der Parameter entspricht dem ATO-Parameter „D_EoA_Offset“ und beträgt in der Regel 5 m. Abweichende Angaben sind durch die betriebliche Infrastrukturplanung in der BAst vorzugeben.&quot;}</rdfs:comment>
        <rdfs:label>Abstand_ATO_Halt_Vor_EoA</rdfs:label>
    </owl:ObjectProperty>
    


