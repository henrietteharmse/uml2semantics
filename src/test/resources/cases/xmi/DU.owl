    <!-- https://uml2semantics.com/ontology/CBUE_Gleisbezogener_Gefahrraum -->


    <owl:Class rdf:about="https://uml2semantics.com/ontology/CBUE_Gleisbezogener_Gefahrraum">
        <rdfs:subClassOf rdf:resource="https://uml2semantics.com/ontology/CBereich_Objekt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
