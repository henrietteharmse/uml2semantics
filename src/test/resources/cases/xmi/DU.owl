        <rdfs:comment>{&quot;Documentation&quot;:&quot;Streckenkilometer der ersten BTS, die an die Bereichsgrenze (RBC-Wechsel) angrenzt.&quot;}</rdfs:comment>
        <rdfs:label>Km_BTS_1</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBgrenze_RBC_Wechsel_BTS_Kette#Km_BTS_2 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBgrenze_RBC_Wechsel_BTS_Kette#Km_BTS_2">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBgrenze_RBC_Wechsel_BTS_Kette"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKm_BTS_2"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Streckenkilometer der zweiten BTS, die an die Bereichsgrenze (RBC-Wechsel) angrenzt.&quot;}</rdfs:comment>
        <rdfs:label>Km_BTS_2</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBgrenze_RBC_Wechsel_BTS_Kette#Km_BTS_3 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBgrenze_RBC_Wechsel_BTS_Kette#Km_BTS_3">
