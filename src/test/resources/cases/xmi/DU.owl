        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLageplan"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLageplan_Bezeichnung"/>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLageplan#ID_Lageplan_Blattschnitt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLageplan#ID_Lageplan_Blattschnitt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLageplan"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Lageplan_Blattschnitt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den zum Lageplan gehörenden Blattschnitt.&quot;}</rdfs:comment>
        <rdfs:label>ID_Lageplan_Blattschnitt</rdfs:label>
    </owl:ObjectProperty>
    


