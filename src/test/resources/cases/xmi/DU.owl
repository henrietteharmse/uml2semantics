        <rdfs:label>Polygonzug_Blattschnitt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLageplan_Blattschnitt_Bezeichnung#Bez_Lageplan_Blattschnitt -->


