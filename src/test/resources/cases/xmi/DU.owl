        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSystem_Vor_Grenze_Besonders"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe des in Bezug auf die Wirkrichtung vor der Bereichsgrenze vorhandenen Class-B-Zugbeeinflussungssystems. Es können mehrere Systeme vorhanden sein.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..30]&quot;}</rdfs:comment>
        <rdfs:label>System_Vor_Grenze_Besonders</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Bezeichnung#Bez_ZUB_Bereichsgrenze -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Bezeichnung#Bez_ZUB_Bereichsgrenze">
