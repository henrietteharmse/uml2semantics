        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLieferobjekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBeschreibung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verbale Beschreibung des LO. 
Die Angabe soll als Beschreibung des Technischen Platzes in SAP R/3 Netz übernommen werden.
Die Bereitstellung der Bildungsvorschrift erfolgt gesondert.&quot;}</rdfs:comment>
        <rdfs:label>Beschreibung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLieferobjekt#ID_GEO_Punkt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLieferobjekt#ID_GEO_Punkt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLieferobjekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_GEO_Punkt_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf einen GEO_Punkt zur Topologie-unabhängigen Lokalisierung des Lieferobjekts. Eine Mehrfachangabe ist bei Verortung in unterschiedlichen Koordinatensystemen notwendig.&quot;}</rdfs:comment>
        <rdfs:label>ID_GEO_Punkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLieferobjekt#ID_LO_Einbau -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLieferobjekt#ID_LO_Einbau">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLieferobjekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_LO_Einbau"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf ein geplantes oder existierendes Objekt bzw. mehrere Objekte, zu dem bzw. denen das LO logisch gehört. LO können auch hierarchisch gegliedert sein.
Für Ersatzteile ist der Ort der Lagerung anzugeben, d.h. in der Regel die Unterbringung direkt.
Der Verweis ist prinzipiell auf alle Objekttypen möglich einschließlich des LO selbst für eine rekursive Darstellung der herstellerspezifischen Anlagenstruktur.&quot;}</rdfs:comment>
        <rdfs:label>ID_LO_Einbau</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLieferobjekt#LO_Ersatz -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLieferobjekt#LO_Ersatz">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLieferobjekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLO_Ersatz"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, ob es sich um eine Ersatzteil (true) oder ein eingebautes und genutztes Teil handelt (false).&quot;}</rdfs:comment>
        <rdfs:label>LO_Ersatz</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLieferobjekt#LO_Material -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLieferobjekt#LO_Material">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLieferobjekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLO_Material"/>
        <rdfs:label>LO_Material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLuft_Telegramm#ID_Balise_Uebertragung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLuft_Telegramm#ID_Balise_Uebertragung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLuft_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Balise_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die Balise, von der das Lufttelegramm gesendet wird. Die Unterscheidung der verschiedenen Lufttelegramme an einer Balise erfolgt über ID_Fachtelegramm bzw. dessen Anschaltbedingung.&quot;}</rdfs:comment>
        <rdfs:label>ID_Balise_Uebertragung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLuft_Telegramm#ID_Fachtelegramm -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLuft_Telegramm#ID_Fachtelegramm">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLuft_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Fachtelegramm"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf 1..* Fachtelegramme, die vom Lufttelegramm umgesetzt werden. Ein Lufttelegramm darf dabei nur auf die Fachtelegramme verweisen, die zu genau einer Menge von Anschaltbedingungen geh&amp;#246;ren (abzuleiten aus Attributgruppe DP_Telegramm). Ein Fachtelegramm kann durch Lufttelegramme mehrerer Balisen eines Datenpunkts umgesetzt werden.&quot;}</rdfs:comment>
        <rdfs:label>ID_Fachtelegramm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLuft_Telegramm#LT_Binaerdatei_Hilfe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLuft_Telegramm#LT_Binaerdatei_Hilfe">
