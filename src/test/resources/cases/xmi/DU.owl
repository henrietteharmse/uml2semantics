    <!-- https://uml2semantics.com/ontology/CSignal -->


    <owl:Class rdf:about="https://uml2semantics.com/ontology/CSignal">
        <rdfs:subClassOf rdf:resource="https://uml2semantics.com/ontology/CPunkt_Objekt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CSignal#Bezeichnung"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
