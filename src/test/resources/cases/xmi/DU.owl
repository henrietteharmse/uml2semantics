        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf eine Hilfsdatei zur Unterstützung bei der Balisenprüfung.&quot;}</rdfs:comment>
        <rdfs:label>ID_Binaerdatei_Hilfe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLT_Binaerdatei_Hilfe#Pruefmerkmale_Binaerdatei_Hilfe -->


