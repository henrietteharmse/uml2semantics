        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAbstand_Datenpunkt_TPI_Folgesignal"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand des Datenpunkts TPI zum Folgesignal in m. Das Folgesignal kann eine ETCS-Haltetafel (Ne 14) sein. DB-Regelwerk  ESG-Datenpunkttabelle 3, Spalte 4&quot;}</rdfs:comment>
        <rdfs:label>Abstand_Datenpunkt_TPI_Folgesignal</rdfs:label>
    </owl:ObjectProperty>
    


