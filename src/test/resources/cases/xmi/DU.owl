            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CBUE_WS_Fstr_Zuordnung#ID_Fstr_Zug_Rangier"/>
