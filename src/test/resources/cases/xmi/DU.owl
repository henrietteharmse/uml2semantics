        <rdfs:label>Bedingung_PZB</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_Anschaltbedingung_Choice_1#Bedingung_Signal -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_Anschaltbedingung_Choice_1#Bedingung_Signal">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_Anschaltbedingung_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBedingung_Signal"/>
