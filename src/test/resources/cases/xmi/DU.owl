    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Allg#Abstand_Gehweg_Fahrbahn -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Allg#Abstand_Gehweg_Fahrbahn">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAbstand_Gehweg_Fahrbahn"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand von der Mitte des Verkehrszeichens zur nächstgelegenen Gehweg- bzw. Fahrbahnkante.Der seitlicher Abstand zur Gleisachse ist über die Eigenschaft \&quot;Punkt_Objekt\&quot; abgebildet.&quot;}</rdfs:comment>
        <rdfs:label>Abstand_Gehweg_Fahrbahn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Allg#Ausrichtung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Allg#Ausrichtung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAusrichtung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Generelle Ausrichtung des Verkehrszeichens in Bezug auf die Topologierichtung der TOP_Kante, an der das Verkehrszeichen verortet ist.&quot;}</rdfs:comment>
        <rdfs:label>Ausrichtung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Allg#Ausrichtung_Winkel -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Allg#Ausrichtung_Winkel">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAusrichtung_Winkel"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[-90..90]&quot;,&quot;Documentation&quot;:&quot;Ausrichtungswinkel des Verkehrszeichens in Bezug auf die Tangente am Verortungspunkt auf der topologischen Kante. Ein direkter Bezug zur Straßenachse ist nicht möglich, da der Straßenverlauf zunächst nur als Bild eingebunden wird.&quot;}</rdfs:comment>
        <rdfs:label>Ausrichtung_Winkel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Blitzpfeil -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Blitzpfeil">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBlitzpfeil"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Auf dem Andreaskreuz ist ein Blitzfeil anzuordnen (true). Das Attribut entfällt, sofern kein Blitzfeil benötigt wird.&quot;}</rdfs:comment>
        <rdfs:label>Blitzpfeil</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Montage_Besonders -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Montage_Besonders">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCMontage_Besonders"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angaben zur besonderen Montage, z. B. für horizontale Befestigung am Peitschenmastausleger.&quot;}</rdfs:comment>
        <rdfs:label>Montage_Besonders</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Richtungspfeil -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Richtungspfeil">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCRichtungspfeil"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zusätzlich zum Andreaskreuz ist ein Richtungspfeil als Schild vorzusehen (true). Das Attribut entfällt, sofern kein Richtungspfeil benötigt wird.&quot;}</rdfs:comment>
        <rdfs:label>Richtungspfeil</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Schutzbuegel -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Schutzbuegel">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSchutzbuegel"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Das Andreaskreuz ist mit einem Schutzbügel auszurüsten (true). Das Attribut entfällt, sofern kein Schutzbügel benötigt wird.&quot;}</rdfs:comment>
        <rdfs:label>Schutzbuegel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Zusatzschild -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz#Zusatzschild">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Andreaskreuz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZusatzschild"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zusatzschild zum Andreaskreuz, z. B. \&quot;Privatweg\&quot; oder \&quot;Übergang nur für Berechtigte\&quot;.&quot;}</rdfs:comment>
        <rdfs:label>Zusatzschild</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Bezeichnung#Bezeichnung_Verkehrszeichen -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Bezeichnung#Bezeichnung_Verkehrszeichen">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBezeichnung_Verkehrszeichen"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bezeichnung des Verkehrszeichens, z. B. S1, Lz1. Die Angabe entfällt bei alleinstehenden Andreaskreuzen.&quot;}</rdfs:comment>
        <rdfs:label>Bezeichnung_Verkehrszeichen</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1#Sperrstrecke -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1#Sperrstrecke">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSperrstrecke"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Sperrstrecke als Abstand Lz/Andreaskreuz - gegenüberliegende Gefahrraumgrenze (d). Die Angabe ist nur bei unbeschrankten Bahnübergängen erforderlich.&quot;}</rdfs:comment>
        <rdfs:label>Sperrstrecke</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1#Sperrstrecke_Fussgaenger -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1#Sperrstrecke_Fussgaenger">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSperrstrecke_Fussgaenger"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Sperrstrecke als Abstand Lz/Andreaskreuz - gegenüberliegende Schranke (dF). Die Angabe ist nur bei beschrankten Bahnübergängen erforderlich.&quot;}</rdfs:comment>
        <rdfs:label>Sperrstrecke_Fussgaenger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1#Vz_Sperrstrecke_Schranke -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1#Vz_Sperrstrecke_Schranke">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CVz_Sperrstrecke_Schranke"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angaben zur Sperrstrecke bei BÜ der Art LzH bzw. LzHH.&quot;}</rdfs:comment>
        <rdfs:label>Vz_Sperrstrecke_Schranke</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Akustik_Fussgaenger -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Akustik_Fussgaenger">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAkustik_Fussgaenger"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Das Lichtzeichen ist mit einer Fußgänger-Akustik auszurüsten (true). Das Attribut entfällt, sofern keine Akustik benötigt wird.&quot;}</rdfs:comment>
        <rdfs:label>Akustik_Fussgaenger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Kontrastblende -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Kontrastblende">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKontrastblende"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;true&quot;,&quot;Documentation&quot;:&quot;Für das Lichtzeichen ist eine Kontrastblende vorzusehen (true). Das Attribut entfällt, wenn keine Kontrastblende benötigt wird.&quot;}</rdfs:comment>
        <rdfs:label>Kontrastblende</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Optik_Durchmesser -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Optik_Durchmesser">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCOptik_Durchmesser"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[200,300]&quot;,&quot;ProposedValue&quot;:&quot;200&quot;,&quot;Documentation&quot;:&quot;Durchmesser der Signalgeberoptik in mm. Der Standardwert sind 200 mm.&quot;}</rdfs:comment>
        <rdfs:label>Optik_Durchmesser</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Optik_Symbolmaske -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Optik_Symbolmaske">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCOptik_Symbolmaske"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Die Signalgeberoptiken sind mit einer Symbolmaske auszurüsten (true). Das Attribut entfällt, sofern keine Symbolmaske benötigt wird.&quot;}</rdfs:comment>
        <rdfs:label>Optik_Symbolmaske</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Schaltgruppe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Schaltgruppe">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSchaltgruppe"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[1..10]&quot;,&quot;Documentation&quot;:&quot;Bei BUESTRA und vorgeschalteten Lz: Zuordnung des Lz zu einer Schaltgruppe.&quot;}</rdfs:comment>
        <rdfs:label>Schaltgruppe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Tragkopf_Verstellbar -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Tragkopf_Verstellbar">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTragkopf_Verstellbar"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Der Tragkopf des Lichtzeichens ist verstellbar (true). Das Attribut entfällt, wenn der Tragkopf nicht verstellbar ist (Standard).&quot;}</rdfs:comment>
        <rdfs:label>Tragkopf_Verstellbar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Vorgeschaltet -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz#Vorgeschaltet">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Lz"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVorgeschaltet"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bei dem Lichtzeichen handelt es sich um ein vorgeschaltetes Lichtzeichen (true). Das Attribut entfällt, sofern das Lichtzeichen nicht vorgeschaltet ist.&quot;}</rdfs:comment>
        <rdfs:label>Vorgeschaltet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVz_Sperrstrecke#Vz_Sperrstrecke_Vorgeschaltet -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVz_Sperrstrecke#Vz_Sperrstrecke_Vorgeschaltet">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVz_Sperrstrecke"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CVz_Sperrstrecke_Vorgeschaltet"/>
