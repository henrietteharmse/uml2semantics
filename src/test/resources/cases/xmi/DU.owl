        <rdfs:label>ID_BUE_Einschaltung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Deckendes_Signal_Zuordnung#ID_Signal -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Deckendes_Signal_Zuordnung#ID_Signal">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Deckendes_Signal_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Signal"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zuordnung zu dem Signal, welches den BÜ deckt (deckendes Haupt-/ LS-Signal).&quot;}</rdfs:comment>
        <rdfs:label>ID_Signal</rdfs:label>
    </owl:ObjectProperty>
    


