        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen_Bezeichnung"/>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen#ID_BUE_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen#ID_BUE_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_BUE_Anlage_ohne_Proxy"/>
