        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBetriebsfuehrung"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;zweigl_GWB&quot;,&quot;Documentation&quot;:&quot;Betriebsführung auf der zugehörigen Strecke. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen.&quot;}</rdfs:comment>
        <rdfs:label>Betriebsfuehrung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBlock_Strecke_Allg#Bremsweg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBlock_Strecke_Allg#Bremsweg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBlock_Strecke_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBremsweg"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;1000&quot;,&quot;Documentation&quot;:&quot;Bremsweg als Grundlage für die Dimesionierung der zugehörigen Strecke. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. Das Attribut wird zukünftig durch einen Verweis auf das Objekt Strecke_Bremsweg ersetzt. Zur Unterstützung der Migration wird das Attribut jedoch zunächst optional beibehalten.&quot;}</rdfs:comment>
        <rdfs:label>Bremsweg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBlock_Strecke_Allg#Strecke_Art -->


