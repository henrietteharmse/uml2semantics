    <!-- https://uml2semantics.com/ontology/CUnterbringung -->


    <owl:Class rdf:about="https://uml2semantics.com/ontology/CUnterbringung">
        <rdfs:subClassOf rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CUnterbringung#Unterbringung_Allg"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Ort der Anordnung von nicht an das Gleis gebundenen Komponenten. Die Verortung der U. erfolgt entweder analog zum Punkt Objekt, mit einem GEO Punkt, einem Polygonzug oder durch einen beschreibenden Text. Eine U. beschreibt in der Regel die Umhausung der Komponente. Ist sie nicht eingehaust, wird als Unterbringung Art \&quot;keine\&quot; angegeben. In diesen Fällen hat die Komponente dennoch eine Unterbringung Befestigung. Das ist z. B. der Fall, wenn eine wetterfeste Komponente (z. B. Schlüsselschalter) ohne Einhausung direkt an einem Pfosten befestigt ist. In einer U. können mehrere LST-Objekte untergebracht sein. Eine U. ist z. B. ein Betonschalthaus oder ein Schaltkasten. DB-Regelwerk Darstellung des Gebäudes im sicherungstechnischen Lageplan nach Ril 819.9002 oder Beschreibung im Erläuterungsbericht&quot;,&quot;ObjectType&quot;:&quot;LST_OBJECT&quot;,&quot;Untergewerke&quot;:&quot;ATO|Bedienung Fdl ESTW|Bedienung Fdl BZ|BÜ| ESTW|ETCS|ZN&quot;}</rdfs:comment>
        <rdfs:label>CUnterbringung</rdfs:label>
    </owl:Class>
    


