        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Aussenelementansteuerung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Übergeordnetes, sekundäres Objekt der Informationsversorgung (wenn vorhanden). Bei DSTW ist der Zugriff durch 4 (Reserve: 5) verschiedene TSO möglich, z. B. bei Einbindung eines BÜ in Fahrstraßen mehrerer ESTW-Zentraleinheiten. DB-Regelwerk Beschreibung im Erläuterungsbericht&quot;}</rdfs:comment>
        <rdfs:label>ID_Information_Sekundaer</rdfs:label>
    </owl:ObjectProperty>
    


