    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CGFR_Anlage_Allg#Hersteller -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CGFR_Anlage_Allg#Hersteller">
