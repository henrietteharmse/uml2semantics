        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Unterbringung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Art des Kabel-Verteilpunkts.&quot;}</rdfs:comment>
        <rdfs:label>ID_Unterbringung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CKabel_Verteilpunkt#Kabel_Verteilpunkt_Art -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CKabel_Verteilpunkt#Kabel_Verteilpunkt_Art">
