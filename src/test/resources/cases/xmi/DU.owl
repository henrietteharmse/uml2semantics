    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CEV_Modul_Physisch#Hersteller -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CEV_Modul_Physisch#Hersteller">
