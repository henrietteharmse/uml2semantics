        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Anhang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf einen Anhang, der die Zuordnung zwischen Eingangsinformationen (z. B. Signalbegriffe) und zugehörigem Lufttelegramm enthält.&quot;}</rdfs:comment>
        <rdfs:label>ID_Anhang_EA_Doku</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLT_Binaerdaten#ID_Binaerdaten -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLT_Binaerdaten#ID_Binaerdaten">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLT_Binaerdaten"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Binaerdaten_ohne_Proxy"/>
