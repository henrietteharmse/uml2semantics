        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCIsolierfall"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Art der Isolierung der Weiche. Es wird bei der Verwendung von Gleisstromkreisen zur Freimeldung die Bezeichnung des Isolierfalls gemäß dem Katalog der Weichenisolierung angegeben.&quot;,&quot;Patternbeschreibung&quot;:&quot; [1..20] &quot;}</rdfs:comment>
        <rdfs:label>Isolierfall</rdfs:label>
    </owl:ObjectProperty>
    


