        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAbstand_Grenze_Bereich_C"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand der Grenze des Bereichs (C) von der ZUB-Bereichsgrenze entgegengesetzt zu deren Wirkrichtung. Das Attribut bildet die maximale Zugänge ab (dmax_Zuglänge). Hinweis: Der beim Ausstieg benötigte Bremswegabstand wird über das Bereichsobjekt \&quot;Strecke_Bremsweg\&quot; ermittelt.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..999]&quot;}</rdfs:comment>
        <rdfs:label>Abstand_Grenze_Bereich_C</rdfs:label>
    </owl:ObjectProperty>
    


