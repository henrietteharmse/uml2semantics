    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Kante#ID_BUE_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Kante"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_BUE_Anlage_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die zugehörige BÜ-Anlage.&quot;}</rdfs:comment>
        <rdfs:label>ID_BUE_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Kreuzungsplan#BUE_Kreuzungsplan_Koordinaten -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan#BUE_Kreuzungsplan_Koordinaten">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan_Koordinaten"/>
        <rdfs:label>BUE_Kreuzungsplan_Koordinaten</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Kreuzungsplan#ID_Anhang_Kreuzungsplan -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan#ID_Anhang_Kreuzungsplan">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Anhang_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den einzubindenden bautechnischen BÜ-Kreuzungsplan als Bild.&quot;}</rdfs:comment>
        <rdfs:label>ID_Anhang_Kreuzungsplan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Kreuzungsplan#ID_BUE_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan#ID_BUE_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_BUE_Anlage_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die für die Ausgabe des Kreuzungsplans relevante BÜ-Anlage.&quot;}</rdfs:comment>
        <rdfs:label>ID_BUE_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Kreuzungsplan_Koordinaten#ID_GEO_Punkt -->


