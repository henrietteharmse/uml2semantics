        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAbstand_Datenpunkt_EP_TPI"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand des Datenpunkts EP zum Datenpunkt TPI in m. DB-Regelwerk  ESG-Datenpunkttabelle 3, Spalte 3&quot;}</rdfs:comment>
        <rdfs:label>Abstand_Datenpunkt_EP_TPI</rdfs:label>
    </owl:ObjectProperty>
    


