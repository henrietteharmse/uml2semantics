        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDP_Verlinkt"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;true&quot;,&quot;Documentation&quot;:&quot;Angabe, ob der Datenpunkt verlinkt ist (true). In jedem von diesem DP gesendeten Telegramm wird in diesem Fall Q_Link = 1 gesetzt.
DB-Regelwerk ESG-Datenpunkttabelle, Spalte \&quot;Linking\&quot;, Eintrag \&quot;L\&quot;&quot;}</rdfs:comment>
        <rdfs:label>DP_Verlinkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDP_Typ_GESG#Lfd_Nr_Am_Bezugspunkt -->


