        <rdfs:label>BUE_Bedien_Anz_Element_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Deckendes_Signal_Zuordnung#ID_BUE_Einschaltung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Deckendes_Signal_Zuordnung#ID_BUE_Einschaltung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Deckendes_Signal_Zuordnung"/>
