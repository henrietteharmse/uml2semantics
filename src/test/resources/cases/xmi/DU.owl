        <rdfs:label>ID_BUE_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen#ID_Unterbringung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CVerkehrszeichen#ID_Unterbringung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CVerkehrszeichen"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Unterbringung_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf eine Unterbringung zur Verortung des Verkehrszeichens&quot;}</rdfs:comment>
        <rdfs:label>ID_Unterbringung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CVerkehrszeichen#Verkehrszeichen_Allg -->


