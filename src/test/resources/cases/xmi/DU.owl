        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKabel_Verteilpunkt_Art"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die Unterbringung des Kabel-Verteilpunkts. Als Art der Unterbringung ist dabei immer \&quot;keine\&quot; auszuwählen, da der Kabel-Verteilpunkt selbst die physische Unterbringung definiert.&quot;}</rdfs:comment>
