        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAdresse_PLZ_Ort"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Adresse der Organisation, Postleitzahl, Ort.
DB Regelwerk
Ggf. Bestandteil des Schriftfeldeintrages gemäß Ril 886.0102 zum mit der Planung beauftragten Ingenieurbüro.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..50]&quot;}</rdfs:comment>
        <rdfs:label>Adresse_PLZ_Ort</rdfs:label>
    </owl:ObjectProperty>
    


