            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CTrasse_Knoten#Trasse_Knoten_Art"/>
