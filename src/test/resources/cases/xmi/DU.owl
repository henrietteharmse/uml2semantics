                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CESTW_Zentraleinheit#ID_Unterbringung"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
