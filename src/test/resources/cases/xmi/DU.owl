        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Bezeichnung"/>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul#ID_Information_Eingang -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul#ID_Information_Eingang">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Information_Eingang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die Quelle(n) der Eingangsinformationen, sofern dieses LEU-Modul Eingangsinformationen aufnimmt. Über eine Aussenelementansteuerung können auch Informationen von Objekten bezogen werden, die nicht im Stellbereich dieser Aussenelementansteuerung liegen.&quot;}</rdfs:comment>
        <rdfs:label>ID_Information_Eingang</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul#ID_LEU_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul#ID_LEU_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_LEU_Anlage_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die LEU-Anlage, zu der das LEU-Modul gehört.&quot;}</rdfs:comment>
        <rdfs:label>ID_LEU_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul#ID_LEU_Schaltkasten -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul#ID_LEU_Schaltkasten">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_LEU_Schaltkasten_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den LEU-Schaltkasten, in dem das LEU-Modul untergebracht ist. Es können LEU-Module verschiedener LEU-Anlagen in einem LEU-Schaltkasten untergebracht sein. Die Angabe entfällt bei ESG.&quot;}</rdfs:comment>
        <rdfs:label>ID_LEU_Schaltkasten</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul#LEU_Modul_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul#LEU_Modul_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Allg"/>
        <rdfs:label>LEU_Modul_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul#LEU_Modul_Ausgang -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul#LEU_Modul_Ausgang">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Ausgang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Attributgruppe zur Zuordnung von Ausgängen des LEU-Moduls zu Balisen.&quot;}</rdfs:comment>
        <rdfs:label>LEU_Modul_Ausgang</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Allg#Hersteller -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Allg#Hersteller">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCHersteller"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Unternehmen, das die Funktionsfähigkeit der Anlage verantwortlich hergestellt hat oder Hersteller des jeweiligen Elements. Diese Eigenschaft ist kein Datum einer Planung, sondern dient im Rücklauf der Planung dazu den Hersteller im Bestand zu erfassen. Es ist die zum Zeitpunkt der Inbetriebnahme gültige Firmierung zu verwenden. DB-Regelwerk Beschreibung im Erläuterungsbericht&quot;}</rdfs:comment>
        <rdfs:label>Hersteller</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Allg#LEU_Modul_Art -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Allg#LEU_Modul_Art">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLEU_Modul_Art"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Art des LEU-Moduls (Voll-LEU, LEU-P). Pflichtangabe bei ESG.&quot;}</rdfs:comment>
        <rdfs:label>LEU_Modul_Art</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Allg#LEU_Modul_Geraetestand -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Allg#LEU_Modul_Geraetestand">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLEU_Modul_Geraetestand"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Gerätestand des LEU-Moduls. Die Information ist im Zusammenhang mit der Angabe \&quot;LEU_Modul_Typ\&quot; zu interpretieren. Beispiel: 3, 12a.&quot;}</rdfs:comment>
        <rdfs:label>LEU_Modul_Geraetestand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Allg#LEU_Modul_Typ -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Allg#LEU_Modul_Typ">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLEU_Modul_Typ"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Herstellerbezogene Typ-Angabe (Rücklaufdatum).&quot;}</rdfs:comment>
        <rdfs:label>LEU_Modul_Typ</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Ausgang#ID_Balise -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Ausgang#ID_Balise">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Ausgang"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Balise"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die über den angegebenen Ausgang angesteuerte Balise.&quot;}</rdfs:comment>
        <rdfs:label>ID_Balise</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Ausgang#LEU_Ausgang_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Ausgang#LEU_Ausgang_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Ausgang"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLEU_Ausgang_Nr"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[1..16]&quot;,&quot;Documentation&quot;:&quot;Planerisch vergebene Nummer des genutzten LEU-Ausgangs für die Ansteuerung der Balisen des Datenpunkts. 
Bei Verwendung in Datenpunkt: Angabe des für diesen DP genutzen LEU-Ausgangs im Sinne einer Referenz. Mehrere Ausgänge werden bei DP mit mehreren gesteuerten Balisen benötigt.
Bei Verwendung in LEU_Modul: Zuordnung des LEU-Ausgangs zu einem LEU-Modul. Weiterhin wird dem LEU-Ausgang vom Hersteller eine Portnummer zugeordnet.&quot;}</rdfs:comment>
        <rdfs:label>LEU_Ausgang_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Ausgang#Port_Nr_Ausg_Physisch -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Ausgang#Port_Nr_Ausg_Physisch">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Ausgang"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPort_Nr_Ausg_Physisch"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Durch den Hersteller vergebene Nummer des Ports, über den Informationen an die Balise ausgegeben werden. Die Angabe kann von LEU_Ausgang_Nr abweichen.&quot;}</rdfs:comment>
        <rdfs:label>Port_Nr_Ausg_Physisch</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Modul_Bezeichnung#Modulnummer -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Modul_Bezeichnung#Modulnummer">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Modul_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCModulnummer"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Nummer des LEU-Moduls, die eindeutig innerhalb einer LEU-Anlage zu wählen ist. Die Gesamtbezeichnung des LEU-Moduls setzt sich aus der Bezeichnung der zugehörigen LEU-Anlage, Unterstrich und der Modulnummer zusammen.
Beispiel:
Bezeichnung LEU-Anlage: AA
Modulnummer: 1
Bezeichnung LEU-Modul: AA_1&quot;}</rdfs:comment>
        <rdfs:label>Modulnummer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten#Bezeichnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten#Bezeichnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Bezeichnung"/>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten#LEU_Schaltkasten_Energie -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten#LEU_Schaltkasten_Energie">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zusatzangaben zur Energieversorgung des LEU-Schaltkastens bzw. der darin befindlichen LEU-Module. Die Angabe ist nur bei ESG erforderlich.&quot;}</rdfs:comment>
        <rdfs:label>LEU_Schaltkasten_Energie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten#LEU_Schaltkasten_Typ -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten#LEU_Schaltkasten_Typ">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLEU_Schaltkasten_Typ"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Typ des LEU-Schaltkastens (schließt Gerätestand ein, i. d. R. Rücklaufdatum).&quot;}</rdfs:comment>
        <rdfs:label>LEU_Schaltkasten_Typ</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Bezeichnung#Nummer_Schaltkasten -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Bezeichnung#Nummer_Schaltkasten">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCNummer_Schaltkasten"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Nummer des Schaltkastens, die der Bezeichnung der LEU-Anlage für die Bezeichnung des LEU-Schaltkastens angefügt wird. Wenn sich in einem LEU-Schaltkasten Module mehrerer LEU-Anlagen befinden, wird die Bezeichnung des LEU-Schaltkastens aus den Bezeichnungen gemäß vorheriger Regel für alle enthaltenen LEU-Anlagen  zusammengesetzt. 
Beispiel:
Bez. LEU-Anlage 1: A1
Bez. LEU-Anlage 2: A2
Nummer_Schaltkasten: 1
Bezeichnung Schaltkasten: A1.1, A2.1&quot;}</rdfs:comment>
        <rdfs:label>Nummer_Schaltkasten</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_1#Position -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_1#Position">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPosition"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Position des LEU-Schaltkastens in Relation zur Wirkrichtung des betrieblichen Bezugspunkts (Signal). Die Ermittlung erfolgt über die zughörigen Datenpunkte.&quot;}</rdfs:comment>
        <rdfs:label>Position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_1#Position_Sonstige -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_1#Position_Sonstige">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPosition_Sonstige"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Sonstige Position des LEU-Schaltkastens, sofern das Attribut \&quot;Position\&quot; nicht verwendet werden kann.&quot;}</rdfs:comment>
        <rdfs:label>Position_Sonstige</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_2#ID_Unterbringung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_2#ID_Unterbringung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_2"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Unterbringung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die Unterbringung des LEU-Schaltkastens, sofern er nicht direkt am Signal positioniert wird. Bei gemeinsamer Unterbringung mit einer Aussenelementansteuerung (z. B. Objektcontroller) ist deren Unterbringung auszuwählen.&quot;}</rdfs:comment>
        <rdfs:label>ID_Unterbringung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_2#LEU_Schaltkasten_Position -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_2#LEU_Schaltkasten_Position">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Choice_2"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Position"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Attributgruppe zur Bestimmung der Position des LEU-Schaltkastens. Die Angabe erfolgt nur bei ESG und ist in diesem Fall obligatorisch.&quot;}</rdfs:comment>
        <rdfs:label>LEU_Schaltkasten_Position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Anzahl_Voll_LEU_Kalkuliert -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Anzahl_Voll_LEU_Kalkuliert">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnzahl_Voll_LEU_Kalkuliert"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Kalkulierte Anzahl der Voll-LEU im LEU-Schaltkasten, sofern planungsseitig noch keine LEU-Module angelegt worden sind oder die Angabe der LEU_Art fehlt (Grundlage für die Energiebedarfsermittlung). Sofern das Attribut im PT 1 genutzt wird, ergibt sich die tatsächliche Anzahl aus den im Rahmen des PT 2 angelegten Instanzen LEU_Modul, die dem LEU-Schaltkasten zugeordnet sind.&quot;}</rdfs:comment>
        <rdfs:label>Anzahl_Voll_LEU_Kalkuliert</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#ID_Energie_LEU_Schaltkasten -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#ID_Energie_LEU_Schaltkasten">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_EV_Modul"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Element, von dem die Energieversorgung der LEU erfolgt.&quot;}</rdfs:comment>
        <rdfs:label>ID_Energie_LEU_Schaltkasten</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Max_Leistung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Max_Leistung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCMax_Leistung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Maximaler Leistungsbedarf des LEU-Schaltkastens (Summe aller LEU-Module). Der Leistungsbedarf soll durch das Planungswerkzeug über LEU_Modul_Art und die Anzahl der zugehörigen Datenpunkte bestimmt werden. Im besonderen Fall ist die Korrektur durch den Planer möglich.&quot;}</rdfs:comment>
        <rdfs:label>Max_Leistung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Spannung_Art -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Spannung_Art">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSpannung_Art"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Nennspannung, mit der der LEU-Schaltkasten betrieben wird.&quot;}</rdfs:comment>
        <rdfs:label>Spannung_Art</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Ueberbrueckung_EV_Unterbrechung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie#Ueberbrueckung_EV_Unterbrechung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Energie"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCUeberbrueckung_EV_Unterbrechung"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[0.00..2.50]&quot;,&quot;Documentation&quot;:&quot;EV-Unterbrechungszeit, die im LEU-Schaltkasten überbrückt werden muss. Sofern eine USV vorgesehen ist, ist keine Überbrückung erforderlich. Hinweis: Erfolgt der LEU-Hochlauf innerhalb von 0,5 s, kann der Hersteller auf eine Überbrückung verzichten.&quot;}</rdfs:comment>
        <rdfs:label>Ueberbrueckung_EV_Unterbrechung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Schaltkasten_Position#ID_Bezugspunkt_Positionierung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Position#ID_Bezugspunkt_Positionierung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Schaltkasten_Position"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bezugspunkt_Positionierung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf einen Bezugspunkt, der für die Positionierung des LEU-Schaltkastens maßgebend ist.&quot;}</rdfs:comment>
        <rdfs:label>ID_Bezugspunkt_Positionierung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Steuernde#ID_LEU_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Steuernde#ID_LEU_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Steuernde"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_LEU_Anlage"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die steuernde LEU-Anlage. Anmerkung: Balisen eines Datenpunkts können nicht mehreren LEU zugeordnet sein. Es ist nur möglich, eine zusammengefasste LEU mit zusammengefasster E/A-Logik aus mehreren LEU-Modulen zu bilden und die Balisen des DP verschiedenen LEU-Modulen zuzuordnen.  &quot;}</rdfs:comment>
        <rdfs:label>ID_LEU_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLEU_Steuernde#LEU_Ausgang_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLEU_Steuernde#LEU_Ausgang_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLEU_Steuernde"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLEU_Ausgang_Nr"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[1..16]&quot;,&quot;Documentation&quot;:&quot;Planerisch vergebene Nummer des genutzten LEU-Ausgangs für die Ansteuerung der Balisen des Datenpunkts. 
Bei Verwendung in Datenpunkt: Angabe des für diesen DP genutzen LEU-Ausgangs im Sinne einer Referenz. Mehrere Ausgänge werden bei DP mit mehreren gesteuerten Balisen benötigt. Die auf diesem Wege für eine LEU-Anlage definierten Port-Nummern müssen für die LEU-Anlage eindeutig sein. Das Attribut wird für den PT 1 ESG nicht genutzt.
Bei Verwendung in LEU_Modul: Zuordnung des LEU-Ausgangs zu einem LEU-Modul. Weiterhin wird dem LEU-Ausgang vom Hersteller eine Portnummer zugeordnet.&quot;}</rdfs:comment>
        <rdfs:label>LEU_Ausgang_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLO_Material#LO_Ausgabestand -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLO_Material#LO_Ausgabestand">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLO_Material"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLO_Ausgabestand"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Ausgabe- bzw. Gerätestand.&quot;}</rdfs:comment>
        <rdfs:label>LO_Ausgabestand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLO_Material#LO_DB_Freigabe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLO_Material#LO_DB_Freigabe">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLO_Material"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLO_DB_Freigabe"/>
