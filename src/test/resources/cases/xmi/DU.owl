    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CW_Kr_Anlage_Allg#Isolierfall -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CW_Kr_Anlage_Allg#Isolierfall">
