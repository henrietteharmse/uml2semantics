        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Bezeichnung"/>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus#ZLV_Bus_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus#ZLV_Bus_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Allg"/>
        <rdfs:label>ZLV_Bus_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Allg#Unterstation_Max -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Allg#Unterstation_Max">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCUnterstation_Max"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Anzahl der maximal auf einen ZLV-Bus anschließbaren Unterstationen. Die Anzahl hängt von der Länge, der Qualität und des Umfangs der Telegramme ab. Nach Ril sind in der Regel maximal 10 Unterstationen pro ZLV-Bus zu planen. DB-Regelwerk 819.0731 5 (12) 819.0731 5 (13) &quot;,&quot;Patternbeschreibung&quot;:&quot; [1..40] &quot;}</rdfs:comment>
        <rdfs:label>Unterstation_Max</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Allg#ZN_Modem -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Allg#ZN_Modem">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_Modem"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Modem, welches die Verbindung zwischen ZN Unterstation und ZLV-Bus für die Datenkommunikation herstellt. Je ZLV-Bus ist nur eine Modembauart zulässig. Für Neuanlagen ist das Modem der Bauart LOGEM 1200 MD oder LineRunner SCADA NG zu verwenden. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk 819.0731A04 1 &quot;}</rdfs:comment>
        <rdfs:label>ZN_Modem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage#Bezeichnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage#Bezeichnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage_Bezeichnung"/>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage#ID_ZLV_Bus -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage#ID_ZLV_Bus">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZLV_Bus_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den ZLV-Bus, an den die Besondere Anlage angeschlossen ist. Mehrere Anschl&amp;#252;sse sind m&amp;#246;glich, z. B. f&amp;#252;r Zugnummern-Dekoder.&quot;}</rdfs:comment>
        <rdfs:label>ID_ZLV_Bus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage#Unterstation_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage#Unterstation_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCUnterstation_Nr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der Unterstationsnummer auf diesem ZLV-Bus. Es wird empfohlen, auf einem ZLV-Bus nur gerade Nummern im Bereich 02..20 oder ungerade Nummern im Bereich 01..19 zu verwenden. DB-Regelwerk 819.0731 5 (12)&quot;}</rdfs:comment>
        <rdfs:label>Unterstation_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage_Bezeichnung#Bezeichnung_Besondere_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage_Bezeichnung#Bezeichnung_Besondere_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Besondere_Anlage_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBezeichnung_Besondere_Anlage"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bezeichnung der besonderen Anlage, die Informationen über den ZLV-Bus empfängt bzw. sendet.&quot;}</rdfs:comment>
        <rdfs:label>Bezeichnung_Besondere_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Bezeichnung#ZLV_Bus_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Bezeichnung#ZLV_Bus_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZLV_Bus_Nr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Nummer des ZLV-Busses. Jeder ZLV-Bus hat eine ihn identifizierende Nummer, die zentral festgelegt wird. Zukünftig wird die Nummer vierstellig angegeben; die ersten beiden Ziffern geben die Region an. Damit ist jeder ZLV-Bus bereits anhand seiner Nummer eindeutig in der Region identifizierbar. Bei BZ-übergreifenden ZLV-Bussen wird der BZ-Code nach Ril 100.0001A01 der ZLV-Bus-Nummer vorangestellt, getrennt durch einen Schrägstrich. Der BZ-Code wird aus dem Verweis auf die Bedien Zentrale generiert. DB-Regelwerk 100.0001A01 819.0731 5 (14) &quot;,&quot;Patternbeschreibung&quot;:&quot; [1..9999] &quot;}</rdfs:comment>
        <rdfs:label>ZLV_Bus_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ID_ZLV_Bus -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ID_ZLV_Bus">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZLV_Bus"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ID des ZLV-Busses, an den die Unterstation angebunden wird. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZLV_Bus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ID_ZN_Unterstation -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ID_ZN_Unterstation">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_Unterstation"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ID der ZLV-Bus-Unterstation, die an den ZLV-Bus angeschlossen wird. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_Unterstation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ZLV_Bus_US_Zuordnung_Telegramm -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ZLV_Bus_US_Zuordnung_Telegramm">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Darstellung von durchzureichenden Telegrammen gemäß Tabelle 2 in der Ril 819.0731 A02. Die Attributgruppe dient der Zuordnung zur Quell-Unterstation, von der ZN-Anzeigefelder und/oder Telegramme durchgereicht werden. Firmenspezifische Telegrammarten werden nicht durchgereicht. DB-Regelwerk 819.0731 A02. Die Darstellung im PT1 erfolgt, wenn überhaupt, im Erläuterungsbericht. &quot;}</rdfs:comment>
        <rdfs:label>ZLV_Bus_US_Zuordnung_Telegramm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ZLV_Bus_Zuordnung_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung#ZLV_Bus_Zuordnung_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Zuordnung_Allg"/>
        <rdfs:label>ZLV_Bus_Zuordnung_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_02 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_02">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegramm_02"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Telegramm 02 (ZN/FN Meldung ohne erfolgte Überschreibung, jedoch auch bei Überspeicherung) ist durchzureichen. Die Angabe von Telegrammen ist für die Durchreichfunktion erforderlich. Eine Aufstellung aller verfügbaren Telegramme steht dem LST-Fachplaner nicht zur Verfügung. Es bedarf der Vorgabe des Betreibers, welche Telegramme von wo nach wo durchgereicht werden sollen. DB-Regelwerk 819.0731A02 &quot;}</rdfs:comment>
        <rdfs:label>Telegramm_02</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_03 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_03">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegramm_03"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Telegramm 03 (Erste FN-Meldung) ist durchzureichen. Die Angabe von Telegrammen ist für die Durchreichfunktion erforderlich. Eine Aufstellung aller verfügbaren Telegramme steht dem LST-Fachplaner nicht zur Verfügung. Es bedarf der Vorgabe des Betreibers, welche Telegramme von wo nach wo durchgereicht werden sollen. DB-Regelwerk 819.0731A02 &quot;}</rdfs:comment>
        <rdfs:label>Telegramm_03</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_04 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_04">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegramm_04"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Telegramm 04 (ZN/FN mit erfolgter Überschreibung von ZN/FN). Die Angabe von Telegrammen ist für die Durchreichfunktion erforderlich. Eine Aufstellung aller verfügbaren Telegramme steht dem LST-Fachplaner nicht zur Verfügung. Es bedarf der Vorgabe des Betreibers, welche Telegramme von wo nach wo durchgereicht werden sollen. DB-Regelwerk 819.0731A02 &quot;}</rdfs:comment>
        <rdfs:label>Telegramm_04</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_10 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_10">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegramm_10"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Telegramm 10 (Einwahl von ZN und Verfügbarkeitshinweisen und Wiederkehr von Verfügbarkeitshinweisen). Die Angabe von Telegrammen ist für die Durchreichfunktion erforderlich. Eine Aufstellung aller verfügbaren Telegramme steht dem LST-Fachplaner nicht zur Verfügung. Es bedarf der Vorgabe des Betreibers, welche Telegramme von wo nach wo durchgereicht werden sollen. DB-Regelwerk 819.0731A02 &quot;}</rdfs:comment>
        <rdfs:label>Telegramm_10</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_21 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_21">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegramm_21"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Telegramm 21 (Löschen von ZN/FN). Die Angabe von Telegrammen ist für die Durchreichfunktion erforderlich. Eine Aufstellung aller verfügbaren Telegramme steht dem LST-Fachplaner nicht zur Verfügung. Es bedarf der Vorgabe des Betreibers, welche Telegramme von wo nach wo durchgereicht werden sollen. Bei ZN-Anlagen der Bauformen Thales (einschließlich Bauformen Alcatel SEL) und Bombardier wird das Telegramm 21 unabhängig von einer Filterung IMMER durchgereicht. DB-Regelwerk 819.0731A02 &quot;}</rdfs:comment>
        <rdfs:label>Telegramm_21</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_30 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm#Telegramm_30">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_US_Zuordnung_Telegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegramm_30"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Telegramm 30 (Ersetzen von ZN/FN). Die Angabe von Telegrammen ist für die Durchreichfunktion erforderlich. Eine Aufstellung aller verfügbaren Telegramme steht dem LST-Fachplaner nicht zur Verfügung. Es bedarf der Vorgabe des Betreibers, welche Telegramme von wo nach wo durchgereicht werden sollen. Bei ZN-Anlagen der Bauformen Thales (einschließlich Bauformen Alcatel SEL) und Bombardier wird das Telegramm 30 unabhängig von einer Filterung IMMER durchgereicht. DB-Regelwerk 819.0731A02 &quot;}</rdfs:comment>
        <rdfs:label>Telegramm_30</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Zuordnung_Allg#Anschlussnummer -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Zuordnung_Allg#Anschlussnummer">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Zuordnung_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnschlussnummer"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Anschlussnummer der (K/M)Unterstation auf dem ZLV-Bus. Jede Unterstation einer Kus hat für jeden angeschlossenen ZLV-Bus eine eigene und einmalige Anschlussnummer. Das Attribut wird nur gefüllt, wenn die Unterstation an mehr als einem ZLV-Bus angeschlossen wird. DB-Regelwerk Allgemeine Angaben finden sich in Ril 819.0731 5 (12).&quot;}</rdfs:comment>
        <rdfs:label>Anschlussnummer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZLV_Bus_Zuordnung_Allg#Unterstation_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZLV_Bus_Zuordnung_Allg#Unterstation_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZLV_Bus_Zuordnung_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCUnterstation_Nr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der Unterstationsnummer auf diesem ZLV-Bus. Es wird empfohlen, auf einem ZLV-Bus nur gerade Nummern im Bereich 02..20 oder ungerade Nummern im Bereich 01..19 zu verwenden. DB-Regelwerk 819.0731 5 (12)&quot;,&quot;Patternbeschreibung&quot;:&quot; [01..40] &quot;}</rdfs:comment>
        <rdfs:label>Unterstation_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Allg#Anzahl_Wiederhol_ZL_Anstoesse -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Allg#Anzahl_Wiederhol_ZL_Anstoesse">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnzahl_Wiederhol_ZL_Anstoesse"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Anzahl erneuter Stellversuche nach negativer Stw-Quittung im Warteintervall von Standard 3-5 s nach positiver Stellbarkeitsprüfung der ZL. DB-Regelwerk 819.0732 5 (2) &quot;,&quot;ProposedValue&quot;:&quot;1&quot;,&quot;PlanningStage&quot;:&quot;PT1&quot;,&quot;Patternbeschreibung&quot;:&quot; [1..10] &quot;}</rdfs:comment>
        <rdfs:label>Anzahl_Wiederhol_ZL_Anstoesse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Allg#Deadlockpruefung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Allg#Deadlockpruefung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDeadlockpruefung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;In der Zuglenkung ist eine Deadlockprüfung (DLP) zu projektieren. Die Angabe, welche Gleisabschnitte in die Prüfung einzubeziehen sind, erfolgt über ein gesondertes Objekt. Die Objekt-Instanzen, die in die DLP einbezogen werden müssen, werden mit den Objekten ZL DLP Fstr und ZL DLP Abschnitt festgelegt. DB-Regelwerk TM 2011-024 I.NVT3 (Fa. Thales) &quot;,&quot;ProposedValue&quot;:&quot;false&quot;}</rdfs:comment>
        <rdfs:label>Deadlockpruefung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Allg#Einstellkontrollzeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Allg#Einstellkontrollzeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCEinstellkontrollzeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Prüfung auf Fahrtstellung Signal nach Anstoß innerhalb einer Zeit, bei Nicht-Fahrtstellung Lenkabbruch, Angabe in Sekunden, Standard 120 s. Der gewählte Wert muss größer sein als die Summe aus Anstoßverzögerung und Fahrstraßenbildungszeit. DB-Regelwerk 819.0732 5 (5) &quot;,&quot;ProposedValue&quot;:&quot;120&quot;,&quot;PlanningStage&quot;:&quot;PT1&quot;,&quot;Patternbeschreibung&quot;:&quot; [1..200] &quot;}</rdfs:comment>
        <rdfs:label>Einstellkontrollzeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Allg#Lenkabbruchzeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Allg#Lenkabbruchzeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLenkabbruchzeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zeit bis zum Lenkabbruch, wenn die zyklische Stellbarkeitsprüfung der ZL bis dahin negativ war. Der Standard-Wert beträgt 600 s. Die Angabe in den Tools muss in Minuten erfolgen. DB-Regelwerk 819.0732 5 (5) &quot;,&quot;ProposedValue&quot;:&quot;600&quot;,&quot;PlanningStage&quot;:&quot;PT1&quot;,&quot;Patternbeschreibung&quot;:&quot; [0..1200] &quot;}</rdfs:comment>
        <rdfs:label>Lenkabbruchzeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Allg#Personal_Reaktionszeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Allg#Personal_Reaktionszeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPersonal_Reaktionszeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Personalreaktionszeit, Angabe in Sekunden. Der Standardwert auf Hauptbahnen beträgt 45 Sekunden, der Standardwert auf Nebenbahnen 15 Sekunden. Abweichungen sind möglich, bedürfen jedoch der betrieblichen Bestätigung.&quot;,&quot;ProposedValue&quot;:&quot;45&quot;,&quot;PlanningStage&quot;:&quot;PT1&quot;,&quot;Patternbeschreibung&quot;:&quot; [15..45] &quot;}</rdfs:comment>
        <rdfs:label>Personal_Reaktionszeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_DLP_Abschnitt#ID_Gleis_Abschnitt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_DLP_Abschnitt#ID_Gleis_Abschnitt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_DLP_Abschnitt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Gleis_Abschnitt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, welche Freimeldeabschnitte geprüft werden müssen.&quot;}</rdfs:comment>
        <rdfs:label>ID_Gleis_Abschnitt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_DLP_Abschnitt#ID_ZL_DLP_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_DLP_Abschnitt#ID_ZL_DLP_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_DLP_Abschnitt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZL_DLP_Fstr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der ZL DLP Fstr, für welche die Gleisabschnitte UND-verknüpft werden müssen. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZL_DLP_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_DLP_Fstr#ID_ZL_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_DLP_Fstr#ID_ZL_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_DLP_Fstr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZL_Fstr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der ZL_Fstr, für welche die DLP erfolgen soll. Die Angabe, zu welcher Betriebsstelle die ZL_Fstr gehört, ist über die Zuordnung der Fstr_Zug_Rangier zur Örtlichkeit indirekt möglich. Mehrere Instanzen mit der gleichen ZL_Fstr müssen dann für die eigentliche systematische Prüfung in der DLP ODER-verknüpft werden. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZL_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr#ID_Fstr_Zug_Rangier -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr#ID_Fstr_Zug_Rangier">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Fstr_Zug_Rangier"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verlinkung, zu welcher Fahrstraße die ZL-Fahrstraße gehört. &quot;}</rdfs:comment>
        <rdfs:label>ID_Fstr_Zug_Rangier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr#ID_ZL -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr#ID_ZL">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZL"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die zugehörige ZL, dessen Bestandteil die ZL-Fahrstraße ist. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZL</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr#ID_ZL_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr#ID_ZL_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZL_Fstr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf eine ZL_Fstr, die als Alternative für die ursprünglich vorgesehene ZL_Fstr verwendet werden kann (in Tabelle ZL „D-Weg_Prio“). &quot;}</rdfs:comment>
        <rdfs:label>ID_ZL_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr#ZL_Fstr_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr#ZL_Fstr_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Allg"/>
        <rdfs:label>ZL_Fstr_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Allg#Annaeherungsgeschwindigkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Allg#Annaeherungsgeschwindigkeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnnaeherungsgeschwindigkeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Geschwindigkeit, die der Berechnung des Anstoßzeitpunktes einer Fahrstraße zugrunde liegt. Die genaue Verwendung des Begriffes ist momentan in der Abstimmung mit den Experten der ZL, da dort in den verschiedenen Bauformen unterschiedliche Philosophien umgesetzt wurden und die Lastenheft-Vorgabe nicht eindeutig ist. DB-Regelwerk Ermittlung gemäß 819.0732 15&quot;,&quot;Patternbeschreibung&quot;:&quot; [40..160] &quot;}</rdfs:comment>
        <rdfs:label>Annaeherungsgeschwindigkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Allg#DWeg_Prio -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Allg#DWeg_Prio">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDWeg_Prio"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[0..4]&quot;,&quot;Documentation&quot;:&quot;D-Weg-Priorität für die vorgesehene ZL-Fahrstraße, wenn diese aus betrieblichen Gründen gefordert wird. Es ist ein Zahlenwert von 0..4 einzutragen.&quot;}</rdfs:comment>
        <rdfs:label>DWeg_Prio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Allg#FUEM_Auswertung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Allg#FUEM_Auswertung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCFUEM_Auswertung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Auswertung der FUEM bei der Einstellung der ZL-Fahrstraße. Die FÜM-Auswertung (blinkend) ist notwendig, wenn bei der vorhergehenden Fstr. ein BÜ enthalten ist, der zum Zeitpunkt des Fstr.-Anstoßes noch nicht geschlossen ist. DB-Regelwerk 819.0732 8 (3) &quot;,&quot;ProposedValue&quot;:&quot;false&quot;}</rdfs:comment>
        <rdfs:label>FUEM_Auswertung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Allg#Fstr_Bildezeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Allg#Fstr_Bildezeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCFstr_Bildezeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Für die Ermittlung des rechtzeitigen Fahrstraßenanstoßes notwendige Fahrstraßenbildezeit. DB-Regelwerk Ril 819.0732&quot;,&quot;Patternbeschreibung&quot;:&quot; [0..900] &quot;}</rdfs:comment>
        <rdfs:label>Fstr_Bildezeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Allg#Sichtzeit_Vorsignal -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Allg#Sichtzeit_Vorsignal">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSichtzeit_Vorsignal"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der Sichtzeit auf das Vorsignal in Sekunden, Standard 15 Sekunden. Der Wert kann projektabhängig verändert werden. Für ZL-Fahrstraßen, die kein Vorsignal haben (LZB-Blockkennzeichen) ist der Wert „0“ anzugeben. DB-Regelwerk 819.0732 5 (2) 819.0732 11 (3) &quot;,&quot;ProposedValue&quot;:&quot;15&quot;,&quot;PlanningStage&quot;:&quot;PT1&quot;,&quot;Patternbeschreibung&quot;:&quot;0,[10..20] &quot;}</rdfs:comment>
        <rdfs:label>Sichtzeit_Vorsignal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ID_Vorsignal -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ID_Vorsignal">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Signal"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Standort der Vorsignalisierung des zu lenkenden Hauptsignals. Die Angabe ist notwendig für die Ermittlung des Sichtpunkts bei vorgegebener Sichtzeit. Es wird aus dem Objekt der Standort (km, Stationierung) benötigt. Der Verweis kann entfallen, wenn der Zug erst am zu lenkenden Hauptsignal startet oder das Startsignal ein LZB-Blockkennzeichen ist.&quot;}</rdfs:comment>
        <rdfs:label>ID_Vorsignal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ID_ZL_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ID_ZL_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZL_Fstr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verlinkung, zu welcher ZL_Fstr dieser Anstoß gehört. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZL_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ZL_Fstr_Anstoss_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ZL_Fstr_Anstoss_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg"/>
        <rdfs:label>ZL_Fstr_Anstoss_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ZL_Fstr_Anstoss_GK -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss#ZL_Fstr_Anstoss_GK">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_GK"/>
        <rdfs:label>ZL_Fstr_Anstoss_GK</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg#GKZSS -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg#GKZSS">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGKZSS"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Der Anstoß aus einem Zugbeeinflussungssystem (ETCS, LZB) ist möglich. DB-Regelwerk 819.0732 13 &quot;}</rdfs:comment>
        <rdfs:label>GKZSS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg#Vmax_Annaeherung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg#Vmax_Annaeherung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVmax_Annaeherung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zulässige Höchstgeschwindigkeit zwischen Vorsignal und berechnetem Einschaltpunkt.&quot;}</rdfs:comment>
        <rdfs:label>Vmax_Annaeherung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg#ZL_Fstr_Zuschlag -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg#ZL_Fstr_Zuschlag">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZL_Fstr_Zuschlag"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zeitzuschlag für die Berechnung des Anstoßpunktes der ZL. Es kann sich die Notwendigkeit ergeben, eine Zeitspanne auf die bisher errechneten Zeiten (Sichtzeit Vorsignal, Fahrstraßenbildungszeit ...) aufzuschlagen, damit der ZL-Anstoß früher erfolgt, als nach der allgemeinen Berechnungsregel vorgesehen. In einem Bearbeitungsvermerk ist dafür eine Begründung anzugeben. Falls kein Zeitzuschlag erforderlich wird, ist das Attribut nicht zu befüllen.&quot;}</rdfs:comment>
        <rdfs:label>ZL_Fstr_Zuschlag</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Choice_1#ID_Einschaltpunkt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Choice_1#ID_Einschaltpunkt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Einschaltpunkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf ein Schaltmittel, welches als Anstoß für die ZL-Fahrstraße ausgewertet wird. Der Standort bzw. die Stationierung geht in die Berechnung einer Verzögerungszeit ein. Das Attribut ist optional, da nicht für jede ZL-Fahrstraße ein Schaltmittel ausgewählt werden kann (z. B. an Stellbereichsgrenzen). In dem Fall ist ein ZN_Anzeigefeld als Anstoßkriterium festzulegen. Einer von beiden Verweisen (ID_Einschaltpunkt oder ID ZN Anzeigefeld Anstoss) muss immer gefüllt sein.&quot;}</rdfs:comment>
        <rdfs:label>ID_Einschaltpunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Choice_1#ID_ZN_Anzeigefeld_Anstoss -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Choice_1#ID_ZN_Anzeigefeld_Anstoss">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_Anzeigefeld_Anstoss"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das ZN Anzeigefeld, aus dem der Anstoß der ZL ausgelöst wird. Das Attribut ist optional, falls für einen ZL-Anstoß kein geeignetes ZN-Anzeigefeld zur Verfügung steht. In dem Fall ist ein Schaltmittel als Anstoßkriterium festzulegen. Einer von beiden Verweisen (ID Einschaltpunkt oder ID_ZN_Anzeigefeld_Anstoss) muss immer gefüllt sein.&quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_Anzeigefeld_Anstoss</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_GK#GK -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_GK#GK">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_GK"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGK"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Geschwindigkeitsklasse, für die die in Tv GK angegebene Geschwindigkeit gilt. Für jede Geschwindigkeitsklasse (GK) ist eine Instanz der Attributgruppe ZL_Fstr_Anstoss_GK anzulegen. Bei der Festlegung von Geschwindigkeitsklassen sind herstellerspezifische Unterschiede zu beachten. DB-Regelwerk 819.0732 14 &quot;,&quot;Patternbeschreibung&quot;:&quot; [40..160] &quot;}</rdfs:comment>
        <rdfs:label>GK</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_GK#Tv_GK -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_GK#Tv_GK">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Fstr_Anstoss_GK"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTv_GK"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verzögerungszeit für den ZL-Anstoß. Ist keine tv erforderlich, ist \&quot;0\&quot; anzugeben. DB-Regelwerk 819.0732 8 (3) 819.0732 11 &quot;,&quot;Patternbeschreibung&quot;:&quot; [0..300] &quot;}</rdfs:comment>
        <rdfs:label>Tv_GK</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Signalgruppe#ID_ZL -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Signalgruppe#ID_ZL">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Signalgruppe"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZL"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die zugehörige ZL, der die Signalgruppe zugeordnet ist. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZL</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Signalgruppe#ZL_Signalgruppe_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Signalgruppe#ZL_Signalgruppe_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Signalgruppe"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZL_Signalgruppe_Allg"/>
        <rdfs:label>ZL_Signalgruppe_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Signalgruppe_Allg#Signalgruppe_Bezeichner -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Signalgruppe_Allg#Signalgruppe_Bezeichner">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Signalgruppe_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSignalgruppe_Bezeichner"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bezeichner der Signalgruppe für ZL und GBT. Die Bezeichnung ist mit dem Besteller abzustimmen.&quot;,&quot;PlanningStage&quot;:&quot;PT1&quot;}</rdfs:comment>
        <rdfs:label>Signalgruppe_Bezeichner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Signalgruppe_Zuordnung#ID_Signal -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Signalgruppe_Zuordnung#ID_Signal">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Signalgruppe_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Signal"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf ein Signal, das der ZL_Signalgruppe zugeordnet wird.&quot;}</rdfs:comment>
        <rdfs:label>ID_Signal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_Signalgruppe_Zuordnung#ID_ZL_Signalgruppe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_Signalgruppe_Zuordnung#ID_ZL_Signalgruppe">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_Signalgruppe_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZL_Signalgruppe"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ZL_Signalgruppe, zu der das zugeordnete Signal gehört.&quot;}</rdfs:comment>
        <rdfs:label>ID_ZL_Signalgruppe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_ZN#Lenkziffernstellen -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_ZN#Lenkziffernstellen">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_ZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLenkziffernstellen"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Stellen der Lenkziffern. Die Angabe ist notwendig, wenn die ZN bereits vorhanden ist und nicht neu geplant wird. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. &quot;,&quot;ProposedValue&quot;:&quot;0&quot;}</rdfs:comment>
        <rdfs:label>Lenkziffernstellen</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZL_ZN#ZN_Stellen -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZL_ZN#ZN_Stellen">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZL_ZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_Stellen"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Stellen der ZN. Die Angabe ist notwendig, wenn die ZN bereits vorhanden ist und nicht neu geplant wird. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht zu finden. &quot;,&quot;ProposedValue&quot;:&quot;5&quot;}</rdfs:comment>
        <rdfs:label>ZN_Stellen</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN#ID_Anhang_ZN_Plan_Bedienraum -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN#ID_Anhang_ZN_Plan_Bedienraum">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Anhang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ID des Raumplans Bedienraum, der als Anhang im Format PDF beigefügt wird. Bei Planung einer ZN-Einwahlstelle bzw. einer ZN in der Nachbarbetriebsstelle ist die Anordnung von Möbeln mit Unterbringung der ZN-Komponenten für den Bedienraum des Stw in einem Plan darzustellen. Dieser wird als PDF beigefügt. Wird die ZN zusammen mit dem zugehörigen ESTW geplant, gibt es keinen Anhang. DB-Regelwerk 819.0731 12 &quot;}</rdfs:comment>
        <rdfs:label>ID_Anhang_ZN_Plan_Bedienraum</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN#ID_Anhang_ZN_Plan_Rechnerraum -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN#ID_Anhang_ZN_Plan_Rechnerraum">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Anhang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ID des Raumplans Rechnerraum, der als Anhang im Format PDF beigefügt wird. Bei Planung einer ZN-Einwahlstelle bzw. einer ZN in der Nachbarbetriebsstelle ist die Anordnung von ZN-Komponenten im Rechnerraum des Stw in einem Plan darzustellen. Dieser wird als PDF beigefügt. Wird die ZN zusammen mit dem zugehörigen ESTW geplant, gibt es keinen Anhang. DB-Regelwerk 819.0731 12 &quot;}</rdfs:comment>
        <rdfs:label>ID_Anhang_ZN_Plan_Rechnerraum</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN#ID_Oertlichkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN#ID_Oertlichkeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Oertlichkeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Örtlichkeit, die für die ZN-Anlage namensgebend ist. Es ist der Wert „Oertlichkeit_Langname“ zu verwenden. &quot;}</rdfs:comment>
        <rdfs:label>ID_Oertlichkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN#ID_Unterbringung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN#ID_Unterbringung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Unterbringung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den physischen Ort der Unterbringung von Aussenelementansteuerung, Bedien Einrichtung Oertlich, Bedien Platz, ESTW Zentraleinheit, PZB Element, Schlosskombination, Schluesselsperre und ZN. Für das PZB Element wird der Verweis nur für eine GÜ gefüllt - mit der Bedeutung: GÜ-Schaltkasten. Für die ZN ist der Verweis optional, da im Planungswerkzeug ZN/ZL keine Befüllung aller der für die Unterbringung notwendigen Attribute möglich ist. DB-Regelwerk Darstellung des Gebäudes, der Bediensäule bzw. des Schaltkastens im sicherungstechnischen Lageplan nach Ril 819.9002 oder Beschreibung im Erläuterungsbericht.&quot;}</rdfs:comment>
        <rdfs:label>ID_Unterbringung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN#ID_ZN_Unterstation -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN#ID_ZN_Unterstation">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_Unterstation"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf ID der zugehörigen ZLV-Bus-Unterstation. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_Unterstation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN#ZN_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN#ZN_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Allg"/>
        <rdfs:label>ZN_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Akustik#ZN_Akustik_Anzeigefeld -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Akustik#ZN_Akustik_Anzeigefeld">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Akustik"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld"/>
        <rdfs:label>ZN_Akustik_Anzeigefeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1#Akustikdauer_Anb_Ann -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1#Akustikdauer_Anb_Ann">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAkustikdauer_Anb_Ann"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Dauer der akustischen Meldung im Anbiete-/Annahmefeld Eine akustische Meldung im Anbiete-/Annahmefeld (mit Anzeige der Zugnummer) ist Standard und daher nicht gesondert zu planen. Es kann nur zwischen der Akustikdauer von 5s oder bis zur Annahme des Zuges unterschieden werden. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es ist nur im Lastenheft zu finden, das dem LST-Fachplaner nicht zur Verfügung steht.&quot;}</rdfs:comment>
        <rdfs:label>Akustikdauer_Anb_Ann</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1#Akustikdauer_Sonst -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1#Akustikdauer_Sonst">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAkustikdauer_Sonst"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Dauer einer akustischen Meldung im ZN Anzeigefeld. Herstellerspezifisch ist es möglich, jedes ZN Anzeigefeld, welches nicht Anbiet-/Annahme- oder Voranzeigefeld ist, mit einer akustischen Meldung bei Befüllung mit einer Zugnummer zu belegen. Dieses Attribut wird nur befüllt, wenn die ZN-Anlage dieses herstellerseitig zulässt. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es bedarf der Abstimmung zwischen LST-Fachplaner und dem Hersteller. &quot;}</rdfs:comment>
        <rdfs:label>Akustikdauer_Sonst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1#Akustikdauer_Voranz -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1#Akustikdauer_Voranz">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Akustik_Anzeigefeld_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAkustikdauer_Voranz"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Dauer einer akustischen Meldung im Voranzeigefeld. Es ist anzugeben, ob bei Befüllen der Voranzeige durch eine Zugnummer eine akustische Meldung erfolgt. Bei den Bauarten der Hersteller Siemens und Thales muss die Angabe für alle Voranzeigefelder einheitlich sein, da eine Unterscheidung je Voranzeigefeld systembedingt z. Zt. nicht realisiert ist. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es bedarf der Abstimmung zwischen LST-Fachplaner und Hersteller.&quot;}</rdfs:comment>
        <rdfs:label>Akustikdauer_Voranz</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Akustik_Choice_1#ID_ZN -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Akustik_Choice_1#ID_ZN">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Akustik_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ZN, für die eine Akustik geplant wird, sofern keine ZN-Anzeigefeld-spezifische Planung möglich ist (herstellerabhängig). &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Akustik_Choice_1#ID_ZN_Anzeigefeld -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Akustik_Choice_1#ID_ZN_Anzeigefeld">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Akustik_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_Anzeigefeld"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das ZN-Anzeigefeld, für das eine Akustik geplant wird (herstellerabhängig). &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_Anzeigefeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Allg#Einwahlstelle -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Allg#Einwahlstelle">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCEinwahlstelle"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;false&quot;,&quot;Documentation&quot;:&quot;Anlage zur Einwahl von Zugnummern. Eine ZN-Einwahlstelle wird im Allgemeinen an benachbarten Stellwerken zu neu errichteten ESTW vorgesehen, sofern diese noch nicht mit einer ZN-Anlage ausgerüstet sind. Hinsichtlich der eigentlichen Planungsdaten einer Einwahlstelle gibt es keine Unterschiede zur Planung einer \&quot;normalen\&quot; ZN-Anlage. Bei der Planung der Einwahlstelle werden die Anhänge für die Einräumung von Rechner- und Bedienraum beigefügt. In der Regel hat die Einwahlstelle keine Anschaltung an die Stellwerkstechnik. Eine Einwahlstelle der Bauform ZNP801 unterscheidet dieses Merkmal hinsichtlich der Anbindung nicht. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es bedarf der umfangreichen Abstimmungen zwischen LST-Fachplaner und Betreiber.&quot;}</rdfs:comment>
        <rdfs:label>Einwahlstelle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Allg#Reaktivierungsfunktion -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Allg#Reaktivierungsfunktion">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCReaktivierungsfunktion"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Im Fall der Störung eines ZLV-Busses sendet die ZN-Anlage ein Reaktivierungstelegramm. In Abhängigkeit zum Hersteller muss die Reaktivierungsfunktion geplant werden. DB-Regelwerk 819.0731 5 (19) &quot;}</rdfs:comment>
        <rdfs:label>Reaktivierungsfunktion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Allg#ZN_Anlagentyp -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Allg#ZN_Anlagentyp">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_Anlagentyp"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Herstellerspezifischer Typ der ZN-Anlage. Aufgrund firmenspezifischer Projektierungsunterschiede muss der Hersteller vor Beginn der Planung bekannt sein. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk Aufgrund firmenspezifischer Projektierungsunterschiede muss der Hersteller vor Beginn der Planung bekannt sein. Siehe dazu Ril 819.0731 A0x. Die Anlagentypen ZNL_800, ZNS_800 und ZNS_801 sind für Neuanlagen nicht mehr zu verwenden.&quot;}</rdfs:comment>
        <rdfs:label>ZN_Anlagentyp</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_Gleis_Abschnitt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_Gleis_Abschnitt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Gleis_Abschnitt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den zugehörigen Gleisabschnitt, in dem das ZN-Anzeigefeld auf der Bedienoberfläche angeordnet wird. &quot;}</rdfs:comment>
        <rdfs:label>ID_Gleis_Abschnitt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_ZLV_Bus -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_ZLV_Bus">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZLV_Bus"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den oder die ZLV_Bus(se), auf den/die das Anzeigefeld durchgereicht wird. Der Verweis wird nur im Falle einer Durchreichung gefüllt. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZLV_Bus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_ZN -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_ZN">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ZN, zu der das ZN-Anzeigefeld gehört. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_ZN_Anzeigefeld -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld#ID_ZN_Anzeigefeld">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_Anzeigefeld"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf ein zugehöriges ZN-Anzeigefeld, z. B. bei der Anordnung von Voranzeige- oder Anbiete-/Annahmefeldern. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_Anzeigefeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld#ZN_Anzeigefeld_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld#ZN_Anzeigefeld_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:label>ZN_Anzeigefeld_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld#ZN_Anzeigefeld_Bezeichnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld#ZN_Anzeigefeld_Bezeichnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Bezeichnung"/>
        <rdfs:label>ZN_Anzeigefeld_Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Bedienbarkeit_Anzeigefeld -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Bedienbarkeit_Anzeigefeld">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBedienbarkeit_Anzeigefeld"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;true&quot;,&quot;Documentation&quot;:&quot;Das Anzeigefeld ist auf der Bedienoberfläche bedienbar. DB-Regelwerk 819.0731 6 (20) &quot;}</rdfs:comment>
        <rdfs:label>Bedienbarkeit_Anzeigefeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Bf_Nr_ANB -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Bf_Nr_ANB">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBf_Nr_ANB"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bahnhofsnummer aus der ZN-Anlage des Nachbarn. Die Angabe wird nur für die ZN-Anzeigefelder mit der Funktionalität ANB/ANN benötigt.&quot;}</rdfs:comment>
        <rdfs:label>Bf_Nr_ANB</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Bf_Nr_ZN_A -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Bf_Nr_ZN_A">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBf_Nr_ZN_A"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bahnhofsnummer, in deren Bereich das ZN-Anzeigefeld angeordnet wird. Es kann dieselbe Bahnhofsnummer sein wie die der gesamten ZN-Anlage, muss es aber nicht. Es ist möglich, dass für jede Betriebsstelle im Erfassungsbereich der ZN-Anlage je eine Bahnhofsnummer geplant werden kann.&quot;}</rdfs:comment>
        <rdfs:label>Bf_Nr_ZN_A</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Funktionalitaet_Anzeigefeld -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Funktionalitaet_Anzeigefeld">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCFunktionalitaet_Anzeigefeld"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der Funktionalität des Anzeigefeldes, aus dem der Buchstabe in der Anzeigefeldbezeichnung abgeleitet wird. Anbiete_Annahmefeld: A, Meldeort: M, Spiegelfeld: S Stapelfeld: N, Voranzeigefeld: V, Wandelfeld: W. Die Anzeigefelder sind auf dem ZN-Übersichtsplan darzustellen. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk 819.0731 6 &quot;}</rdfs:comment>
        <rdfs:label>Funktionalitaet_Anzeigefeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#HOA -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#HOA">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCHOA"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der in dem betreffenden ZN Anzeigefeld auszuwertenden HOA (Heißläufer-Ortungs-Anlage). Im Datenmodell wird nicht die Anlage selber berücksichtigt, sondern nur deren Auswertung im ZN Anzeigefeld. Es wird auf dem ZN-Übersichtsplan an dem betreffenden ZN Anzeigefeld die Nummer der auszuwertenden HOA mit dem Zusatz „Nur zur Information“ vermerkt. DB-Regelwerk 819.0731 8 (4) &quot;}</rdfs:comment>
        <rdfs:label>HOA</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Sichtbarkeit_Anzeigefeld -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Sichtbarkeit_Anzeigefeld">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSichtbarkeit_Anzeigefeld"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;true&quot;,&quot;Documentation&quot;:&quot;Das ZN Anzeigefeld ist auf der Bedienoberfläche sichtbar. DB-Regelwerk 819.0731 6 (19) &quot;}</rdfs:comment>
        <rdfs:label>Sichtbarkeit_Anzeigefeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Verzoegerung_Manuell_Loeschung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Verzoegerung_Manuell_Loeschung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVerzoegerung_Manuell_Loeschung"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;300&quot;,&quot;Documentation&quot;:&quot;Verzögerungszeit, bis die Löschung der Zugnummer erfolgt. Die Angabe ist bei manueller Zugnummernlöschung notwendig. Standard lt. LH sind ca. 5 min. DB-Regelwerk Das Planungsdatum ist nur im Lastenheft zu finden, das dem LST-Fachplaner nicht zur Verfügung steht. &quot;}</rdfs:comment>
        <rdfs:label>Verzoegerung_Manuell_Loeschung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Vormeldestart -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Vormeldestart">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVormeldestart"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, ob aus diesem ZN Anzeigefeld eine Vormeldung generiert wird Sofern aus dem ZN_Anzeigefeld eine Vormeldung generiert wird, ist die entsprechende Richtung anzugeben. Wird keine Vormelduing generiert, erfolgt in dem Attribut keine Angabe. DB-Regelwerk In der Ril 819.0731 sind zur Vormeldung keine Aussagen getroffen. Bisher erfolgen die notwendigen Angaben regionalbereichsspezifisch als Symbol und/oder Text mit/ohne Beschreibung konkreter Vormeldebedingungen.&quot;}</rdfs:comment>
        <rdfs:label>Vormeldestart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#ZN_Anzeigefeld_Loeschkriterium -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#ZN_Anzeigefeld_Loeschkriterium">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_Anzeigefeld_Loeschkriterium"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe des Kriteriums, mit dem die Zugnummer aus dem ZN Anzeigefeld gelöscht wird. Das Kriterium wird vorrangig für ZN-Anzeigefelder an der Grenze der eigenen zur benachbarten ZN-Anlage angegeben. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk 819.0731 7 (4) enthält nur eine allgemeine Aussage. Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es bedarf der Abstimmung zwischen LST-Fachplaner und Betreiber.&quot;}</rdfs:comment>
        <rdfs:label>ZN_Anzeigefeld_Loeschkriterium</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#ZN_Feld_Ohne_Anzeige -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#ZN_Feld_Ohne_Anzeige">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_Feld_Ohne_Anzeige"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;false&quot;,&quot;Documentation&quot;:&quot;Im ZN Anzeigefeld erfolgt keine Anzeige einer Zugnummer. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es findet sich im Lastenheft, das dem LST-Fachplaner nicht zur Verfügung steht.&quot;}</rdfs:comment>
        <rdfs:label>ZN_Feld_Ohne_Anzeige</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Zugvorbereitungsmeldung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg#Zugvorbereitungsmeldung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZugvorbereitungsmeldung"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;false&quot;,&quot;Documentation&quot;:&quot;In diesem ZN-Anzeigefeld ist eine Zugvorbereitungsmeldung im ZN-Übersichtsplan zu kennzeichnen; die ZN-Anlage enthält keine ZFM-Funktionalität. Im Regelwerk wird dieses Planungsdatum historisch bedingt als \&quot;Zugfertigmeldung\&quot; bezeichnet. DB-Regelwerk 819.0731 6 (23) &quot;}</rdfs:comment>
        <rdfs:label>Zugvorbereitungsmeldung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Bezeichnung#ZN_A_Bedienbezeichner_Frei -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Bezeichnung#ZN_A_Bedienbezeichner_Frei">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_A_Bedienbezeichner_Frei"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[4..7]&quot;,&quot;Documentation&quot;:&quot;Angabe des ESTW-Bedienbezeichners als Texteingabe, Im Regelfall entspricht der Bedienbezeichner des ZN_Anzeigefeldes dem des zugehörigen Gleisfreimeldeabschnitts, in dem das ZN_Anzeigefeld angeordnet wird. Falls abweichend vom Regelfall nicht die Bezeichnung des Gleisfreimeldeabschnitts angewendet werden kann oder wird, ist eine Bezeichnung als Freitext festzulegen. DB-Regelwerk 819.0731&quot;}</rdfs:comment>
        <rdfs:label>ZN_A_Bedienbezeichner_Frei</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Anzeigefeld_Bezeichnung#ZN_A_Bezeichner -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Bezeichnung#ZN_A_Bezeichner">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Anzeigefeld_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_A_Bezeichner"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der Anzeigefeldbezeichnung als numerischer Wert. Als Bezeichnung ist eine ZN-Gleisnummer festzulegen, die für den Bereich der ZN-Anlage eindeutig sein muss. Die Bezeichnung (ZN-Gleisnummer) sollte aus der Gleisbezeichnung des ESTW hergeleitet werden. Spiegelfelder werden wie das gespiegelte Anzeigefeld bezeichnet. Anbiete-/Annahme sowie Voranzeigefelder erhalten eine Bezeichnung, die eine Zuordnung zum ZN Anzeigefeld im zugehörigen Gleisabschnitt erkennen lässt. Das Attribut dient der eindeutigen Erkennung des ZN-Anzeigefeldes auf dem ZLV-Bus und wird daher auch „ZLV-Bus-Bezeichner“ genannt. DB-Regelwerk 819.0731 6 (14) &quot;}</rdfs:comment>
        <rdfs:label>ZN_A_Bezeichner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Choice_1#Bezeichnung_Stellwerk -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Choice_1#Bezeichnung_Stellwerk">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBezeichnung_Stellwerk"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bezeichnung des Stellwerks, sofern kein Verweis auf eine ESTW-Zentraleinheit m&amp;#246;glich ist (z. B. \&quot;Relaisstellwerk xyz\&quot;).&quot;}</rdfs:comment>
        <rdfs:label>Bezeichnung_Stellwerk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Choice_1#ID_Stellwerk -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Choice_1#ID_Stellwerk">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Stellwerk"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ESTW-Zentraleinheit, zu der diese ZN oder f&amp;#252;r die eine ZN-Einwahlstelle geplant wurde. Der Verweis ist optional, da im Plaungswerkzeug ZN/ZL keine Bef&amp;#252;llung aller f&amp;#252;r die ESTW-ZE vorgesehenen Attribute m&amp;#246;glich ist. Der Verweis auf Aussenelementansteuerung soll nicht mehr genutzt werden. Zur Angabe der Bezeichnung eines Relaisstellwerks wird mit Version 1.11 eine Modellerweiterung erfolgen.&quot;}</rdfs:comment>
        <rdfs:label>ID_Stellwerk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Ausfahrdruck -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Ausfahrdruck">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAusfahrdruck"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Druck nach Ausfahrt eines Zuges. Im ZN Anzeigefeld wird ein Druck nach Ausfahrt des Zuges generiert. Die Ausgabe erfolgt auf einem ZN-Drucker oder in ein Doku-System. Das DB-Regelwerk enthält keine konkreten Planungsvorgaben. Es bedarf der Abstimmung zwischen LST-Fachplaner und späterem Betreiber. DB-Regelwerk Allgemein gehaltene Aussagen zu den Drucken finden sich in 819.0731 2 (3) 819.0731 6 (12) 819.0731 6 (18) &quot;}</rdfs:comment>
        <rdfs:label>Ausfahrdruck</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Ausfahrdruck_Gegengleis -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Ausfahrdruck_Gegengleis">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAusfahrdruck_Gegengleis"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Druck nach Ausfahrt des Zuges ins Gegengleis. Im ZN Anzeigefeld wird ein Druck nach Ausfahrt des Zuges ins Gegengleis generiert. Die Ausgabe erfolgt auf einem ZN-Drucker oder in ein Doku-System. Das DB-Regelwerk enthält keine konkreten Planungsvorgaben. Es bedarf der Abstimmung zwischen LST-Fachplaner und späterem Betreiber. DB-Regelwerk Allgemein gehaltene Aussagen zu den Drucken finden sich in 819.0731 2 (3) 819.0731 6 (12) 819.0731 6 (18) &quot;}</rdfs:comment>
        <rdfs:label>Ausfahrdruck_Gegengleis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Durchfahrdruck -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Durchfahrdruck">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDurchfahrdruck"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Druck nach Durchfahrt des Zuges. Im ZN Anzeigefeld wird ein Druck nach Durchfahrt des Zuges (z. B. nach Passieren eines Bahnhofsteils) generiert. Die Ausgabe erfolgt auf einem ZN-Drucker oder in ein Doku-System. Das DB-Regelwerk enthält keine konkreten Planungsvorgaben. Es bedarf der Abstimmung zwischen LST-Fachplaner und späterem Betreiber. DB-Regelwerk Allgemein gehaltene Aussagen zu den Drucken finden sich in 819.0731 2 (3) 819.0731 6 (12) 819.0731 6 (18) &quot;}</rdfs:comment>
        <rdfs:label>Durchfahrdruck</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Einfahrdruck -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Einfahrdruck">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCEinfahrdruck"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Druck nach Einfahrt des Zuges. Im ZN Anzeigefeld wird ein Druck nach Einfahrt des Zuges in den Bahnhof generiert. Die Ausgabe erfolgt auf einem ZN-Drucker oder in ein Doku-System. Das DB-Regelwerk enthält keine konkreten Planungsvorgaben. Es bedarf der Abstimmung zwischen LST-Fachplaner und späterem Betreiber. DB-Regelwerk Allgemein gehaltene Aussagen zu den Drucken finden sich in 819.0731 2 (3) 819.0731 6 (12) 819.0731 6 (18) &quot;}</rdfs:comment>
        <rdfs:label>Einfahrdruck</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Einfahrdruck_Gegengleis -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Einfahrdruck_Gegengleis">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCEinfahrdruck_Gegengleis"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Druck nach Einfahrt des Zuges aus dem Gegengleis. Im ZN Anzeigefeld wird ein Druck nach Einfahrt des Zuges aus dem Gegengleis in den Bahnhof generiert. Die Ausgabe erfolgt auf einem ZN-Drucker oder in ein Doku-System. Das DB-Regelwerk enthält keine konkreten Planungsvorgaben. Es bedarf der Abstimmung zwischen LST-Fachplaner und späterem Betreiber. DB-Regelwerk Allgemein gehaltene Aussagen zu den Drucken finden sich in 819.0731 2 (3) 819.0731 6 (12) 819.0731 6 (18) &quot;}</rdfs:comment>
        <rdfs:label>Einfahrdruck_Gegengleis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Meldedruck -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck#Meldedruck">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCMeldedruck"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Druck nach Fortschaltung der Zugnummer. Im ZN Anzeigefeld wird ein Druck nach Fortschaltung der Zugnummer generiert. Die Ausgabe erfolgt auf einem ZN-Drucker oder in ein Doku-System. Das DB-Regelwerk enthält keine konkreten Planungsvorgaben. Es bedarf der Abstimmung zwischen LST-Fachplaner und späterem Betreiber. DB-Regelwerk Allgemein gehaltene Aussagen zu den Drucken finden sich in 819.0731 2 (3) 819.0731 6 (12) 819.0731 6 (18) &quot;}</rdfs:comment>
        <rdfs:label>Meldedruck</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#Besonderes_Schaltkriterium -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#Besonderes_Schaltkriterium">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBesonderes_Schaltkriterium"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe von besonderen Fortschaltkriterien für die Zugnummernfortschaltung als Kommentar. Die Angabe kann auch in Verbindung mit dem Attribut ZN Schaltkriterium erfolgen; z. B. \&quot;positive Stellbarkeitsprüfung Signal xy\&quot;. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es bedarf dazu der Abstimmung zwischen LST-Fachplaner und Betreiber.&quot;}</rdfs:comment>
        <rdfs:label>Besonderes_Schaltkriterium</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#ID_Fortschaltung_Start -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#ID_Fortschaltung_Start">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Fortschaltung_Start"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Startelement, von dem fortgeschaltet wird. Aus Start und Ziel lässt sich eine Fortschaltrichtung ableiten. DB-Regelwerk 819.0731 6 (15) 819.0731 6 (16) 819.0731 6 (17) &quot;}</rdfs:comment>
        <rdfs:label>ID_Fortschaltung_Start</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#Telegrammwiederholung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#Telegrammwiederholung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegrammwiederholung"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;false&quot;,&quot;Documentation&quot;:&quot;Bei Fortschaltung wird die Sendung des Telegramms wiederholt. Falls keine Telegrammwiederholung erfolgt, wird das Attribut nicht befüllt. DB-Regelwerk 819.0731 6 (21) &quot;}</rdfs:comment>
        <rdfs:label>Telegrammwiederholung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#ZN_Schaltkriterium -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt#ZN_Schaltkriterium">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZN_Schaltkriterium"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Kriterium zur Fortschaltung der Zugnummer. Die Angabe eines ZN-Fortschaltkriteriums erfolgt, sofern es nicht Funktionalität der Anlage ist (ENUM-Wert „kein“). Firmenspezifische Besonderheiten nach Ril 819.0731A03 sind zu beachten. Das Kriterium \&quot;Signalhaltfall\&quot; beinhaltet neben Haltstellung von Hauptsignalen auch das Erlöschen von Kennlicht, Sh1, Ersatz- bzw. Vorsichtssignalen. Diese sind im ESTW Stellwerksfunktionalität und werden nicht explizit geplant. Das Kriterium der Haltstellung von virtuellen Signalen (Anwendung bei ETCS) wird zu einem späteren Zeitpunkt im Modell berücksichtigt. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk Ril 819.0731A03 &quot;}</rdfs:comment>
        <rdfs:label>ZN_Schaltkriterium</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium#ID_ZN -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium#ID_ZN">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ZN, zu der das Fortschaltkriterium gehört. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium#ID_ZN_Fortschalt_Krit_Start -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium#ID_ZN_Fortschalt_Krit_Start">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_Anzeigefeld"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das ZN Anzeigefeld in der Bedienoberfläche, von dem aus die Zugnummer fortgeschaltet wird. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_Fortschalt_Krit_Start</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium#ID_ZN_Fortschalt_Krit_Ziel -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Fortschalt_Kriterium#ID_ZN_Fortschalt_Krit_Ziel">
