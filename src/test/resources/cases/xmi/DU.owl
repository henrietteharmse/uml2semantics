        <rdfs:label>ID_BUE_Gleisbez_Gefahrraum</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Bedien_Anz_Element_Allg#BUE_Handschalteinrichtung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Bedien_Anz_Element_Allg#BUE_Handschalteinrichtung">
