        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bedien_Anzeige_Element"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Bedien Anzeige Element, welches die Zuordnung zur Bedien Einrichtung Oertlich und damit zur physischen Unterbringung der Tasten herstellt. &quot;}</rdfs:comment>
        <rdfs:label>ID_Bedien_Anzeige_Element</rdfs:label>
    </owl:ObjectProperty>
    


