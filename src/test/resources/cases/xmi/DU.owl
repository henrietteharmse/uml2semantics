    <!-- https://uml2semantics.com/ontology/CFT_ETCS_L2_Merkmale#FT_ETCS_L2_Typ -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ETCS_L2_Merkmale#FT_ETCS_L2_Typ">
