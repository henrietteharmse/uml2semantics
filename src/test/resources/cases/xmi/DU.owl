        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[6], hexadezimal&quot;, &quot;Documentation&quot;:&quot;RGB-Kodierung (hexadezimal) für den Farbton, in dem die Linie dargestellt werden soll.&quot;}</rdfs:comment>
        <rdfs:label>Linie_Farbwert</rdfs:label>
    </owl:ObjectProperty>
    


