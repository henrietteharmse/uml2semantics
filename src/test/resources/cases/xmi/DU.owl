        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLO_Datum_Herstellung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Produktionszeitpunkt des LO.&quot;}</rdfs:comment>
        <rdfs:label>LO_Datum_Herstellung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLO_Material#LO_EMA_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLO_Material#LO_EMA_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLO_Material"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLO_EMA_Nr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;EMA-Nummer der DB (zur Nachbestellbarkeit des Ersatzeils über die DB-internen Beschaffungswege).
Für LO ohne EMA-Nummer ist \&quot;ohne EMA-Nummer\&quot; anzugeben.&quot;}</rdfs:comment>
        <rdfs:label>LO_EMA_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLO_Material#LO_Firmensachnummer -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLO_Material#LO_Firmensachnummer">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLO_Material"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLO_Firmensachnummer"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Firmensachnummer.&quot;}</rdfs:comment>
        <rdfs:label>LO_Firmensachnummer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLO_Material#LO_Seriennummer -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLO_Material#LO_Seriennummer">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLO_Material"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLO_Seriennummer"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Seriennummer des Bauteils. Falls keine existiert, ist \&quot;ohne Seriennummer\&quot; einzutragen.&quot;}</rdfs:comment>
        <rdfs:label>LO_Seriennummer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLST_Objekte_Planungsbereich#ID_LST_Objekt_Planungsbereich -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLST_Objekte_Planungsbereich#ID_LST_Objekt_Planungsbereich">
