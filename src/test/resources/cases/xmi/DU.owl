            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>CStrecke_Bezeichnung</rdfs:label>
    </owl:Class>
    


    <!-- https://uml2semantics.com/ontology/CStrecke_Bremsweg -->


