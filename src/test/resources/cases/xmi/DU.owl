        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBgrenze_Nach_ESG_Bed_Ausstieg"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angaben zur Entscheidungsweiche bei bedingten Ausstieg aus dem vorherigen System.&quot;}</rdfs:comment>
        <rdfs:label>Bgrenze_Nach_ESG_Bed_Ausstieg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Nach_ESG#Harter_Ausstieg_Aus_L2 -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Nach_ESG#Harter_Ausstieg_Aus_L2">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Nach_ESG"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCHarter_Ausstieg_Aus_L2"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bei Übergang von L2: Angabe, ob es sich um einen harten Ausstieg handelt (true). Bei einem harten Ausstieg erfolgt keine Ankündigung durch das RBC.&quot;}</rdfs:comment>
        <rdfs:label>Harter_Ausstieg_Aus_L2</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Nach_ESG#Prioritaet -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Nach_ESG#Prioritaet">
