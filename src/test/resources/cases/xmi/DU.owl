        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/TCSignalbegriff_ID"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/string"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Langbezeichnung des Signalbegriffs gemäß Ril 301 (Signalbuch). Das Attribut ist nicht durch den Planer veränderbar.&quot;}</rdfs:comment>
