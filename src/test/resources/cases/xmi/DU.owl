        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Schalt"/>
        <rdfs:label>ZN_Fortschalt_Krit_Schalt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung#ID_ZN -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung#ID_ZN">
