        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAder_Durchmesser"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bei Signalkabeln: Durchmesser der Kabeladern in mm. Bsp.: 3x4x1,4.&quot;,&quot;Patternbeschreibung&quot;:&quot;[0.1..1.8]&quot;}</rdfs:comment>
        <rdfs:label>Ader_Durchmesser</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CKabel_Element_Choice_1#Ader_Querschnitt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CKabel_Element_Choice_1#Ader_Querschnitt">
