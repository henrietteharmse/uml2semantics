        </rdfs:subClassOf>
        <rdfs:comment>{&quot;ObjectType&quot;:&quot;LST_OBJECT&quot;,&quot;Documentation&quot;:&quot;Gleisbezogene Abbildung der B&amp;#220;-Kante zur Berechnung des Sicherheitsabstands bei Hp-gedeckten Bahn&amp;#252;berg&amp;#228;ngen. Es ist nur eine punktf&amp;#246;rmige Verortung auf einer Gleiskante anzugeben.&quot;,&quot;Untergewerke&quot;:&quot;B&amp;#220;&quot;}</rdfs:comment>
