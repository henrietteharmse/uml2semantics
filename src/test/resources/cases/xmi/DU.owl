        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CGeschwindigkeitsprofil_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnzeigegefuehrt_ES_Kategorie"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Kategorie f&amp;#252;r Geschwindigkeitsprofile der Art \&quot;anzeigegef&amp;#252;hrt ES\&quot;, z. B. G&amp;#252;ltigkeit f&amp;#252;r Reise- oder G&amp;#252;terz&amp;#252;ge. \&quot;ES\&quot; steht dabei f&amp;#252;r erh&amp;#246;hte Seitenbeschleunigung.&quot;}</rdfs:comment>
        <rdfs:label>Anzeigegefuehrt_ES_Kategorie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CGeschwindigkeitsprofil_Allg#Geschwindigkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CGeschwindigkeitsprofil_Allg#Geschwindigkeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CGeschwindigkeitsprofil_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGeschwindigkeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zulässige Geschwindigkeit nach jeweiligem Geschwindigkeitsprofil. &quot;}</rdfs:comment>
        <rdfs:label>Geschwindigkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CGeschwindigkeitsprofil_Allg#V_Profil_Art -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CGeschwindigkeitsprofil_Allg#V_Profil_Art">
