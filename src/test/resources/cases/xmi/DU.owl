        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVBC_Kennung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Kennung des Virtuel Balise Cover (VBC). Je nach Typ des Fachtelegramms gibt das Attribut die zu setzende/löschende Kennung oder die Kennung des zugehörigen Datenpunkts an.&quot;}</rdfs:comment>
        <rdfs:label>VBC_Kennung</rdfs:label>
    </owl:ObjectProperty>
    


