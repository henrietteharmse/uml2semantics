        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CLEU_Steuernde"/>
        <rdfs:label>LEU_Steuernde</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Allg#Anwendungssystem -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Allg#Anwendungssystem">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnwendungssystem"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Hauptanwendungssystem des Datenpunkts, aus dem die Angabe auf dem Balisenschild  (z. B. GNT, ESG, ETCS) abgeleitet wird. Bei Ausr&amp;#252;stung mit ETCS L2oS ist der Wert \&quot;L2\&quot; zu verwenden. Die Kennzeichnung von Datenpunkten im ETCS-&amp;#220;bersichtsplan wird nicht aus diesem Attribut abgeleitet, sondern aus den vorhandenen Attributgruppen DP_Typ_Gxxxx.&quot;}</rdfs:comment>
        <rdfs:label>Anwendungssystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Allg#Ausrichtung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Allg#Ausrichtung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAusrichtung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;(Physikalische) Ausrichtung der Balisengruppe in Bezug auf die Topologierichtung. Bei der Angabe \&quot;keine\&quot; handelt es sich um eine Einzelbalise. In diesem Fall kann dem Fahrzeuggerät die Ausrichtung über die Linking-Information von einem zurückliegenden Datenpunkt übermittelt werden.&quot;}</rdfs:comment>
        <rdfs:label>Ausrichtung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Allg#Datenpunkt_Beschreibung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Allg#Datenpunkt_Beschreibung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDatenpunkt_Beschreibung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Ergänzende Beschreibung des Datenpunkts (z. B. Abweichungen bei Einmesspunkten).&quot;}</rdfs:comment>
        <rdfs:label>Datenpunkt_Beschreibung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Allg#Datenpunkt_Laenge -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Allg#Datenpunkt_Laenge">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDatenpunkt_Laenge"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[0.0..84.0]&quot;,&quot;Documentation&quot;:&quot;Abstand zwischen erster und letzter Balise des Datenpunkts. Die genaue Verteilung der Balisen innerhalb dieser Länge wird nicht abgebildet. Die Angabe entfällt, sofern es sich um eine Einzel-Balise handelt.&quot;}</rdfs:comment>
        <rdfs:label>Datenpunkt_Laenge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Allg#Sonstige_Standortangabe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Allg#Sonstige_Standortangabe">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSonstige_Standortangabe"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Sonstige Angabe des Balisenstandortes, sofern unter Standortangabe_Balisenschild die Option \&quot;Strecke sonstiger Standort\&quot; gewählt wurde. Beispiele: \&quot;60W32L\&quot;, \&quot;BGRU 023\&quot; (= Berlin-Grunewald Nr. 23).&quot;}</rdfs:comment>
        <rdfs:label>Sonstige_Standortangabe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Allg#Standortangabe_Balisenschild -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Allg#Standortangabe_Balisenschild">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCStandortangabe_Balisenschild"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Auswahl der Bezeichnungskomponenten f&amp;#252;r die Angabe des Balisenstandortes auf dem Balisenschild. Die aufzubringende Bezeichnung ergibt sich aus weiteren im Datenmodell vorhandenen Angaben und wird regelbasiert durch den Hersteller festgelegt.
Bei ETCS L2 ist keine Angabe erforderlich.&quot;}</rdfs:comment>
        <rdfs:label>Standortangabe_Balisenschild</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Einmesspunkt#Abstand_Einmesspunkt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Einmesspunkt#Abstand_Einmesspunkt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Einmesspunkt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAbstand_Einmesspunkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Soll-Abstand zum unter ID_Einmesspunkt angegebenen Referenzpunkt für die Montage. Das Attribut darf nur in den XML-Dateien für die Balisen-Programmiergeräte gefüllt sein (Ersatz für die topologische Berechnung des Abstands). Die Umsetzung der Richtungsinformationen in den Planunterlagen muss entsprechend des Anwendungssystems festgelegt und im Werkzeug implementiert werden.&quot;}</rdfs:comment>
        <rdfs:label>Abstand_Einmesspunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Einmesspunkt#ID_Einmesspunkt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Einmesspunkt#ID_Einmesspunkt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Einmesspunkt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Markanter_Punkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den Referenzpunkt f&amp;#252;r die Montage. ETCS L2: Vorl&amp;#228;ufig wird dieser Verweis nicht verwendet.&quot;}</rdfs:comment>
        <rdfs:label>ID_Einmesspunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Link#ID_DP_Link_Start -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Link#ID_DP_Link_Start">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Link"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Datenpunkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Datenpunkt, von dem das Linking ausgeht (Start). Sofern der Datenpunkt nur über ID_DP_Link_Start referenziert wird, erhält er die Kennung \&quot;A\&quot; (Anfang des Linkings). Bei Referenzierung über ID_DP_Link_Start wie auch ID_DP_Link_Ziel handelt es sich um einen Unterwegs-DP (Kennung \&quot;U\&quot;).&quot;}</rdfs:comment>
        <rdfs:label>ID_DP_Link_Start</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Link#ID_DP_Link_Ziel -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Link#ID_DP_Link_Ziel">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Link"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Datenpunkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Ziel-Datenpunkt des betreffenden Linkings. Sofern der Datenpunkt nur über ID_DP_Link_Ziel referenziert wird, erhält er die Kennung \&quot;E\&quot; (Ende des Linkings). Bei Referenzierung über ID_DP_Link_Start wie auch ID_DP_Link_Ziel handelt es sich um einen Unterwegs-DP (Kennung \&quot;U\&quot;).&quot;}</rdfs:comment>
        <rdfs:label>ID_DP_Link_Ziel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Link#ID_Fachtelegramm -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Link#ID_Fachtelegramm">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Link"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Fachtelegramm"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe aller Fachtelegramme, denen die Linking-Information zugeordnet wird. Die Angabe bezieht sich auf den Start-Datenpunkt des ersten Linkings. Dies ist der Datenpunkt, in dem die Linking-Informationen übertragen werden.&quot;}</rdfs:comment>
        <rdfs:label>ID_Fachtelegramm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Link#Link_Distanz -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Link#Link_Distanz">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Link"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLink_Distanz"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand zwischen Start- und Ziel-Datenpunkt des Linkings. Die Angabe ist erforderlich, um bei mehreren Fahrwegen zwischen Start- und Ziel-Datenpunkt die relevante Distanz eindeutig zu bestimmen.
Sofern mehrere Fahrwege und damit Distanzen zwischen Start- und Ziel-Datenpunkt existieren, sind mehrere Instanzen von Datenpunkt_Link anzulegen.&quot;}</rdfs:comment>
        <rdfs:label>Link_Distanz</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Link#Ziel_DP_Ausrichtung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt_Link#Ziel_DP_Ausrichtung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt_Link"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZiel_DP_Ausrichtung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Durch das Linking festgelegte Ausrichtung des Ziel-Datenpunkts in Bezug auf die Fahrtrichtung des auswertenden Zuges. Bei ESG entfällt die Angabe.&quot;}</rdfs:comment>
        <rdfs:label>Ziel_DP_Ausrichtung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt_Link_Choice_1#Anwendung_ESG -->


