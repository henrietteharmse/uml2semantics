    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung_Choice_1#Telegramm_84_Einzelne_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung_Choice_1#Telegramm_84_Einzelne_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CTelegramm_84_Einzelne_Fstr"/>
        <rdfs:label>Telegramm_84_Einzelne_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung_Choice_1#Telegramm_84_Verzicht -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung_Choice_1#Telegramm_84_Verzicht">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Telegramm_84_Zuordnung_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegramm_84_Verzicht"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;false&quot;,&quot;Documentation&quot;:&quot;Verzicht auf Sendung des Telegramms 84. Bei Bedienung der HaGT wird das Telegramm unabhängig von der Projektierung des Verzichts gesendet.&quot;}</rdfs:comment>
        <rdfs:label>Telegramm_84_Verzicht</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung#ID_ZN -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung#ID_ZN">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ZN, von der das Telegramm 85 generiert und auf den ZLV-Bus gesandt wird. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung_Choice_1#Telegramm_85_Alle_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung_Choice_1#Telegramm_85_Alle_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CTelegramm_85_Alle_Fstr"/>
        <rdfs:label>Telegramm_85_Alle_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung_Choice_1#Telegramm_85_Einzelne_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung_Choice_1#Telegramm_85_Einzelne_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Telegramm_85_Zuordnung_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CTelegramm_85_Einzelne_Fstr"/>
        <rdfs:label>Telegramm_85_Einzelne_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation#ID_ZN_ZBS -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation#ID_ZN_ZBS">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_ZBS"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die ID der zugehörigen ZLV-Bus-Sammelleitung (ZBS), sofern diese vorhanden ist. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_ZBS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation#ZN_Unterstation_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation#ZN_Unterstation_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:label>ZN_Unterstation_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Allg#Bf_Kennung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Allg#Bf_Kennung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBf_Kennung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der Bahnhofskennung. Die erste Ziffer gibt die Basis für die Bestimmung der Fehlnummernbereiche an (2 = 20, 5 = 50). In BZ-Bereichen kann die Vergabe von gleichen Bahnhofsadressen nicht ausgeschlossen werden. Es sind daher Bereiche mit eindeutiger Bahnhofsadresse festzulegen und zur Unterscheidung von Nachbarbereichen mit einer Bahnhofskennung zu markieren. Die Fehlnummernbereiche werden automatisch in Abhängigkeit der Bahnhofskennung gebildet (siehe Ril 819.0731A03 (3)). Dies gilt für alle Bauarten der ZN. DB-Regelwerk 819.0731A03 (3) &quot;,&quot;Patternbeschreibung&quot;:&quot; [0..4] &quot;}</rdfs:comment>
        <rdfs:label>Bf_Kennung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Allg#KUs_Zeittelegramm -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Allg#KUs_Zeittelegramm">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKUs_Zeittelegramm"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, ob die Koppelunterstation (KUs) zur Zeitsynchronisation ein Zeittelegramm auf den ZLV-Bus sendet (true) oder nicht (false). Sind zwei
KUs an einem ZLV-Bus angeschlossen, so darf jeweils nur eine KUs ein Zeittelegramm auf den ZLV-Bus senden. DB-Regelwerk 819.0731 5 (22)&quot;}</rdfs:comment>
        <rdfs:label>KUs_Zeittelegramm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Allg#Koppelunterstation -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Allg#Koppelunterstation">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKoppelunterstation"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, ob es sich um eine Koppelunterstation handelt. Bei einer Koppelunterstation treffen ein oder mehrere ZLV-Bus-Leitungen sowie eine ZBS zusammen. Eine Koppelunterstation hat somit immer eine Anbindung an die Betriebszentrale (BZ). Eine Unterstation hat eine oder mehrere Anbindung(en) an einen ZLV-Bus. DB-Regelwerk Für das Planungsdatum gibt es im Regelwerk der DB AG keine konkrete Vorgabe. Die Art der Unterstation ergibt sich aus dem ZLV-Bus-Konzept, welches die DB AG erstellt. 819.0731 5 (17). Koppelunterstationen erhalten eine ZBS-Anbindung. 819.0731 8 (1), 819.0731 8 (2), 819.0731 9 (7), 819.0731 A05. &quot;}</rdfs:comment>
        <rdfs:label>Koppelunterstation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Allg#ZBS_Adresse -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Allg#ZBS_Adresse">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZBS_Adresse"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der ZBS-Adresse (KUs-Kennung) für die Koppelunterstation. Bei einer MUs (Mehrfachunterstation) bzw. Us (Unterstation) wird das Attribut nicht gefüllt. Die Angabe erfolgt hexadezimal. DB-Regelwerk 819.0731 5 (16) &quot;,&quot;Patternbeschreibung&quot;:&quot; [A0..FF] hexadezimal, ohne AA und BB &quot;}</rdfs:comment>
        <rdfs:label>ZBS_Adresse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Allg#ZBS_Anbindung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Allg#ZBS_Anbindung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZBS_Anbindung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Die Unterstation erhält eine ZBS-Anbindung. DB-Regelwerk 819.0731 8 (1) 819.0731 8 (2) 819.0731 9 (7) 819.0731A05 &quot;}</rdfs:comment>
        <rdfs:label>ZBS_Anbindung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Allg#ZN_Unterstation_Bf_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Allg#ZN_Unterstation_Bf_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr"/>
        <rdfs:label>ZN_Unterstation_Bf_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Allg#Zeitsynchronisation_Funkuhr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Allg#Zeitsynchronisation_Funkuhr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZeitsynchronisation_Funkuhr"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;true&quot;,&quot;Documentation&quot;:&quot;Angabe, ob eine Zeitsynchronisation über Funkuhr zu projektieren is (true). Bei Benutzung der Funkuhr darf keine Zeitsynchronisation über den ZLV-Bus (Telegramm 80) oder über Network-Time-Protocol (ntp) erfolgen. Der Wert \&quot;false\&quot; wird nicht verwendet. DB-Regelwerk Ril 819.0731 2 (4)&quot;}</rdfs:comment>
        <rdfs:label>Zeitsynchronisation_Funkuhr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr#Bf_Nr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr#Bf_Nr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBf_Nr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der Bahnhofsnummer zur eindeutigen Identifikation einer Betriebsstelle auf dem ZLV-Bus. Die Bahnhofsnummer muss im Bereich der angrenzenden ZLV-Busse eindeutig sein. Bei der Verwendung von Bahnhosnummern in Bereichen mit (Koppel-/Mehrfach-)Unterstation (siehe ZN Unterstation Art) sind besondere Randbedingungen zu beachten. DB-Regelwerk 819.0731 5 (3) 819.0731 5 (4) Bei Bereichen mit (K/M)-Unterstationen: 819.0731 5 (5) - (7)&quot;,&quot;Patternbeschreibung&quot;:&quot;[01..99]&quot;}</rdfs:comment>
        <rdfs:label>Bf_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr#ID_Oertlichkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr#ID_Oertlichkeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Oertlichkeit_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Örtlichkeit, die einer Bahnhofsnummer zugeordnet ist, welche zusätzlich von der ZN_Unterstation verwaltet wird. Es ist der Wert \&quot;Oertlichkeit_Abkuerzung\&quot; zu verwenden. &quot;}</rdfs:comment>
        <rdfs:label>ID_Oertlichkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr#Prioritaet -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr#Prioritaet">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_Unterstation_Bf_Nr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPrioritaet"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der maßgebenden Bahnhofsnummer der ZN Unterstation Das Attribut wird nur für diejenige Bahnhofsnummer mit \&quot;1\&quot; befüllt, welche für die Kommunikation der ZN_Unterstation mit dem ZLV Bus maßgebend ist. In allen übrigen Fällen wird das Attribut nicht befüllt. DB-Regelwerk Das Planungsdatum hat keine Entsprechung im Regelwerk. Es findet zeichnerisch Anwendung auf dem ZLV-Bus-Übersichtsplan einzelner Regionen.&quot;}</rdfs:comment>
        <rdfs:label>Prioritaet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_ZBS#ID_ESTW_Zentraleinheit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_ZBS#ID_ESTW_Zentraleinheit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_ZBS"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ESTW_Zentraleinheit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den Ort der räumlichen Unterbringung der Koppelunterstation &quot;}</rdfs:comment>
        <rdfs:label>ID_ESTW_Zentraleinheit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_ZBS_Choice_1#IP_Adresse -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_ZBS_Choice_1#IP_Adresse">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_ZBS_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCIP_Adresse"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;IP_Adresse des COM-Servers gemäß Ril 819.0705. Der Planungsfall tritt ein, wenn eine ZBS-Verbindung zwischen ZN Unterstation und BZ zu planen ist. DB-Regelwerk 819.0731A05 819.0705 &quot;,&quot;Patternbeschreibung&quot;:&quot; [7..15] gebildet aus vier maximal dreistelligen Zahlen, getrennt durch Punkte &quot;}</rdfs:comment>
        <rdfs:label>IP_Adresse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZN_ZBS_Choice_1#ZBS_Schnittstelle -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZN_ZBS_Choice_1#ZBS_Schnittstelle">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZN_ZBS_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCZBS_Schnittstelle"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Modem, welches die Verbindung zwischen ZN Unterstation und ZBS für die Datenkommunikation herstellt. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk 819.0731A04 2 &quot;}</rdfs:comment>
        <rdfs:label>ZBS_Schnittstelle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze#Bezeichnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze#Bezeichnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Bezeichnung"/>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze#ID_Oertlichkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze#ID_Oertlichkeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Oertlichkeit_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Maßgebende Örtlichkeit des Stellbereichs, in dem sich die Bereichsgrenze befindet.&quot;}</rdfs:comment>
        <rdfs:label>ID_Oertlichkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze#ZUB_Bereichsgrenze_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze#ZUB_Bereichsgrenze_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg"/>
        <rdfs:label>ZUB_Bereichsgrenze_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg#ID_Element_Grenze -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg#ID_Element_Grenze">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Element_Grenze"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Grenzsignal bzw. den Grenzdatenpunkt. Der Ort der Bereichsgrenze kann sich vom Ort des Grenzelements unterscheiden.
Bereichsgrenze nach L2: Verweis auf das Grenzsignal (Einstiegssignal für L2) bzw. den Grenzdatenpunkt (nur bei Einstieg ohne bekanntes rückwärtiges Signal)
Bereichsgrenze nach ESG: Verweis auf den Transitionsdatenpunkt (Einstieg für ESG)
Bereichsgrenze nach PZB/LZB: Verweis auf einen Transitionsdatenpunkt (ESG) bzw. auf das Ausstiegssignal (L2)
Bereichsgrenze RBC-Wechsel: Verweis auf das Grenzsignal, an dem die Zuständigkeit des RBC wechselt
Bereichsgrenze nach GNT: Verweis auf den ersten GNT-Datenpunkt (B1 oder B3)
Bereichsgrenze nach OHNE: Verweis auf das Grenzsignal (bei Übergang aus PZB) bzw. den Grenzdatenpunkt (bei Übergang aus ESG oder L2)&quot;}</rdfs:comment>
        <rdfs:label>ID_Element_Grenze</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg#ID_RBC_Vor_Grenze -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg#ID_RBC_Vor_Grenze">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_RBC"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bei L2: Verweis auf das vor der Bereichsgrenze zuständige RBC.&quot;}</rdfs:comment>
        <rdfs:label>ID_RBC_Vor_Grenze</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg_Choice_2#System_Vor_Grenze -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg_Choice_2#System_Vor_Grenze">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CZUB_Bereichsgrenze_Allg_Choice_2"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSystem_Vor_Grenze"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe des in Bezug auf die Wirkrichtung vor der Bereichsgrenze vorhandenen Zugbeeinflussungssystems. Es können mehrere Systeme vorhanden sein.&quot;}</rdfs:comment>
        <rdfs:label>System_Vor_Grenze</rdfs:label>
    </owl:ObjectProperty>
    


