    <!-- https://uml2semantics.com/ontology/CFstr_Nichthaltfall -->


    <owl:Class rdf:about="https://uml2semantics.com/ontology/CFstr_Nichthaltfall">
        <rdfs:subClassOf rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
