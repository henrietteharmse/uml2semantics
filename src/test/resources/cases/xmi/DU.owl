        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Signal"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf ein Signal, welches den Zustand der W_Kr_Anlage signalisiert (z. B. Rückfallweichensignal).&quot;}</rdfs:comment>
        <rdfs:label>ID_Signal</rdfs:label>
    </owl:ObjectProperty>
    


