        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZLV_Bus"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Der Verweis wird gefüllt, wenn das Telegramm 84 durchzureichen ist. Verweis auf den ZLV-Bus, auf den das Telegramm durchgereicht wird. &quot;}</rdfs:comment>
        <rdfs:label>ID_ZLV_Bus</rdfs:label>
    </owl:ObjectProperty>
    


