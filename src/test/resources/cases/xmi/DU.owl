        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDateityp_Binaerdatei"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[3..5]&quot;,&quot;Documentation&quot;:&quot;Typ der Binaerdatei (z. B. txt, tlg).&quot;}</rdfs:comment>
        <rdfs:label>Dateityp_Binaerdatei</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBlock_Anlage#Block_Anlage_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBlock_Anlage#Block_Anlage_Allg">
