        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFachtelegramm"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_AnhangBearbeitungsvermerk"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf einen Anhang oder Bearbeitungsvermerk mit folgenden möglichen Inhalten: Umsetzung der Fachtelegramme auf die Lufttelegramme, Lastenheftangaben, Planungsrichtlinien, SRS-Version.&quot;}</rdfs:comment>
        <rdfs:label>ID_Doku_Telegrammkodierung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFachtelegramm#Wirkrichtung_In_Datenpunkt -->


