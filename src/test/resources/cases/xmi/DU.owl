        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCNID_C_ATOTS"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[0..1023]&quot;,&quot;Documentation&quot;:&quot;Gebietskennung als Bestandteil der ATO-Kennung (ATO-ID) gemäß Subset 126, Version 0.0.17 vom 05.08.2020.
Die Gebietskennung NID_C_ATOTS für ATO-TS- Instanzen wird aus der ETCS-Gebietskennung (NID_C) des entsprechenden Bereichs übernommen.&quot;}</rdfs:comment>
        <rdfs:label>NID_C_ATOTS</rdfs:label>
    </owl:ObjectProperty>
    


