        <rdfs:comment>{&quot;Documentation&quot;:&quot;Telefonnummer der Organisation.
DB Regelwerk
Ggf. Bestandteil des Schriftfeldeintrages gemäß Ril 886.0102 zum mit der Planung beauftragten Ingenieurbüro.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..30]&quot;}</rdfs:comment>
        <rdfs:label>Telefonnummer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element#ID_PZB_Element_Zuordnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element#ID_PZB_Element_Zuordnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_PZB_Element_Zuordnung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Objekt PZB_Element_Zuordnung zur Angabe des Bezugspunkts bzw. der Bezugspunkte und ggf. bestehender Fahrstraßen-Abhängigkeiten.&quot;}</rdfs:comment>
        <rdfs:label>ID_PZB_Element_Zuordnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element#PZB_Art -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element#PZB_Art">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPZB_Art"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Art des PZB-Elementes.&quot;}</rdfs:comment>
        <rdfs:label>PZB_Art</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Choice_1#ID_Stellelement -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Choice_1#ID_Stellelement">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Stellelement"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Objekt Stellelement zur Zusammenfassung von Eigenschaften der Objekte BUE Schnittstelle, PZB Element, Schluesselsperre, Signal, W Kr Gsp Element. Das Stellelement enthält Informationen über den energetischen und logischen Anschluss der Objekte. Für das PZB Element ist der Verweis nicht zu füllen, wenn damit eine GÜ oder ein ständig wirksamer Gleismagnet abgebildet wird. DB-Regelwerk Bisher ohne eindeutige Darstellung &quot;}</rdfs:comment>
        <rdfs:label>ID_Stellelement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Choice_1#ID_Unterbringung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Choice_1#ID_Unterbringung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Unterbringung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den physischen Ort der Unterbringung von Aussenelementansteuerung, Bedien Einrichtung Oertlich, Bedien Platz, ESTW Zentraleinheit, PZB Element, Schlosskombination, Schluesselsperre und ZN. Für das PZB Element wird der Verweis nur für eine GÜ gefüllt - mit der Bedeutung: GÜ-Schaltkasten. Für die ZN ist der Verweis optional, da im Planungswerkzeug ZN/ZL keine Befüllung aller der für die Unterbringung notwendigen Attribute möglich ist. DB-Regelwerk Darstellung des Gebäudes, der Bediensäule bzw. des Schaltkastens im sicherungstechnischen Lageplan nach Ril 819.9002 oder Beschreibung im Erläuterungsbericht.&quot;}</rdfs:comment>
        <rdfs:label>ID_Unterbringung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Choice_2#PZB_Element_GM -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Choice_2#PZB_Element_GM">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Choice_2"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GM"/>
        <rdfs:label>PZB_Element_GM</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Choice_2#PZB_Element_GUE -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Choice_2#PZB_Element_GUE">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Choice_2"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:label>PZB_Element_GUE</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GM#PZB_Abstand_GM -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GM#PZB_Abstand_GM">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GM"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPZB_Abstand_GM"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand des PZB-Magneten zum Signal, für den eine INA-Berechnung durchgeführt wurde. Der aktuelle Abstand wird über die Verortung der beiden Punktobjekte ermittelt.&quot;,&quot;Patternbeschreibung&quot;:&quot;[-6..300]&quot;}</rdfs:comment>
        <rdfs:label>PZB_Abstand_GM</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GM#PZB_INA -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GM#PZB_INA">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GM"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPZB_INA"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;false&quot;,&quot;Documentation&quot;:&quot;Der PZB-Magnet deckt gemäß Wirkbereichsbogen Bereiche ab (\&quot;true\&quot;). Liegt ein Bahnsteig zwischen den PZB-Magneten von Vor- und nachfolgendem Hauptsignal, wird eine INA-Berechnung durchgeführt. Das Ergebnis wird in einem Wirkbereichsbogen dokumentiert. Daraus geht die Relevanz des PZB-Magneten für die Überwachung gegen Halt anfahrender Züge hervor: Z. B. \&quot;Der GM 1000 Hz deckt bei bei einer Beschleunigung von 0,3 m/s² die Bereiche von ... bis ... m ab.\&quot; oder \&quot;Der GM 2000 Hz deckt keine Bereiche ab\&quot;. &quot;}</rdfs:comment>
        <rdfs:label>PZB_INA</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Abstand_Abweichend -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Abstand_Abweichend">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGUE_Abstand_Abweichend"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe des von der Regelanordnung abweichenden Abstandes einer GÜ zum Signal. Das Attribut wird nur befüllt, wenn der Abstand der GUE zum Signal gemäß Ril 819.1310 Anhang 01 aus baulichen Gründen nicht realisiert werden kann. Es ist dann der Abstand zwischen GUE und Signal anzugeben. Dann sind die Toleranzen gemäß Ril 819.1310 Abschnitt 9, Absatz (4) einzuhalten. DB-Regelwerk 819.1310A01 in Verbindung mit 819.1310 9 (4) &quot;}</rdfs:comment>
        <rdfs:label>GUE_Abstand_Abweichend</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Anordnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Anordnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGUE_Anordnung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe des Anordnungsfalles des Prüf- und der Prüfmagneten einer GÜ. Fall 1 (EA): in Fahrtrichtung zuerst Einschaltmagnet (GSE), dann Wirkmagnet, dann Ausschaltmagnet (GSA). Fall 2 (AE): in Fahrtrichtung zuerst Ausschaltmagnet (GSA) dann Einschaltmagnet (GSE), dann Wirkmagnet. Nach Ril 819.1310 ist im Regelfall die Variante gemäß Fall 1 anzuwenden. DB-Regelwerk 819.1310 9 819.1310A01 &quot;,&quot;ProposedValue&quot;:&quot;1_EA&quot;}</rdfs:comment>
        <rdfs:label>GUE_Anordnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Bauart -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Bauart">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGUE_Bauart"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bauart der GÜ, von der weitere Planungsparameter wie Messfehler oder Pruefzeit abhängen. DB-Regelwerk Ril 819.1310A01&quot;}</rdfs:comment>
        <rdfs:label>GUE_Bauart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Energieversorgung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Energieversorgung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGUE_Energieversorgung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, wie die Energieversorgung der GÜ erfolgt. Bei GÜ, die zur Überwachung restriktiver Geschwindigkeiten an Signalen bzw. für Weichen geplant werden, erfolgt die Stromversorgung im Regelfall aus dem zugehörigen Stellwerk. Bei Lf-Signalen der freien Strecke, die einer GÜ-Sicherung bedürfen, ist im Regelfall die Solarspeisung vorzusehen, da sich keine geeignete Stromversorgung in der Nähe befindet. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Es ergibt sich aus dem konkreten Anwendungsfall.&quot;,&quot;ProposedValue&quot;:&quot;Stellwerk&quot;}</rdfs:comment>
        <rdfs:label>GUE_Energieversorgung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Messstrecke -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#GUE_Messstrecke">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCGUE_Messstrecke"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe über die Länge der Messstrecke der GÜ in [m]. Aus Sicht des LST-Planers ist die Messstrecke das maßgebende Planungskriterium, die aufgrund der örtlichen Verhältnisse (z. B. Weichenlage, Schweißstelle, andere sicherungstechnischen Elemente) festzulegen ist. Daraus ergibt sich die dann zu realisierende Bauform der GÜ. DB-Regelwerk 819.1310A01 7 819.1310A01 8 &quot;,&quot;Patternbeschreibung&quot;:&quot; [5.80..75.00] &quot;}</rdfs:comment>
        <rdfs:label>GUE_Messstrecke</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#ID_PZB_Element_Mitnutzung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#ID_PZB_Element_Mitnutzung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_PZB_Element_Mitnutzung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Mit Ausnahme von GÜ bei Lf-Signalisierung werden bei der Anordnung von GÜ unmittelbar am Signal (meist im Zusammenhang mit geschwindigkeitsmindernden Zusatzanzeigern) der Wirkmagnet der GÜ und der PZB-Magnet des Signals zu einem PZB-Magneten zusammengefasst. DB-Regelwerk Der Sachverhalt ist in der Ril 819.1310 zwar nicht eindeutig beschrieben, geht jedoch aus den Tabelleneinträgen im Anhang 01 hervor.&quot;}</rdfs:comment>
        <rdfs:label>ID_PZB_Element_Mitnutzung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#Messfehler -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#Messfehler">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCMessfehler"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Messfehlerbereich der GÜ in Abhängigkeit von der Bauart DB-Regelwerk Ril 819.1310A01&quot;}</rdfs:comment>
        <rdfs:label>Messfehler</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#Pruefgeschwindigkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#Pruefgeschwindigkeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPruefgeschwindigkeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe der an der GÜ eingestellten Überwachungsgeschwindigkeit in [km/h]. Bis auf die Überwachungsgeschwindigkeiten 95 und 105 erhalten die GÜ eine Wirkmagnet mit 2000 Hz; für GÜ 95 und 105 einen Wirkmagneten mit 1000 Hz. Eine explizite Angabe der Wirkfrequenz bei der GÜ ist daher nicht vorgesehen. DB-Regelwerk 819.1310A01 3 819.1310A01 5 819.1310A01 6 &quot;,&quot;Patternbeschreibung&quot;:&quot; [10..150] &quot;}</rdfs:comment>
        <rdfs:label>Pruefgeschwindigkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_GUE#Pruefzeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_GUE#Pruefzeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_GUE"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPruefzeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Prüfzeit der GÜ in Abhängigkeit von der Bauart. DB-Regelwerk Ril 819.1310A01&quot;,&quot;Patternbeschreibung&quot;:&quot;[0.00..99.99]&quot;}</rdfs:comment>
        <rdfs:label>Pruefzeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung#PZB_Element_Zuordnung_BP -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung#PZB_Element_Zuordnung_BP">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP"/>
        <rdfs:label>PZB_Element_Zuordnung_BP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung#PZB_Element_Zuordnung_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung#PZB_Element_Zuordnung_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_Fstr"/>
        <rdfs:label>PZB_Element_Zuordnung_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#ID_PZB_Element_Bezugspunkt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#ID_PZB_Element_Bezugspunkt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_PZB_Element_Bezugspunkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Signal bzw. die Weiche, in dessen Abhängigkeit das PZB Element angeordnet werden muss. Während bei PZB-Element-GM im Regelfall das Signal anzugeben ist, können PZB-Element-GUE auch in Abhängigkeit einer Weiche angeordnet werden (z.B. Spätablenkung). DB-Regelwerk Gleismagnettabelle 1 &quot;}</rdfs:comment>
        <rdfs:label>ID_PZB_Element_Bezugspunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#INA_Gefahrstelle -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#INA_Gefahrstelle">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CINA_Gefahrstelle"/>
        <rdfs:label>INA_Gefahrstelle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#PZB_Element_Zuordnung_INA -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#PZB_Element_Zuordnung_INA">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_INA"/>
        <rdfs:label>PZB_Element_Zuordnung_INA</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#Wirksamkeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP#Wirksamkeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_BP"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCWirksamkeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, ob der Gleismagnet/ die GÜ schaltbar ist oder nicht bzw. wie die Anschaltung erfolgt. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk Gleismagnettabelle&quot;,&quot;ProposedValue&quot;:&quot;schaltbar_von_Signal&quot;}</rdfs:comment>
        <rdfs:label>Wirksamkeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_Fstr#ID_Fstr_Zug_Rangier -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_Fstr#ID_Fstr_Zug_Rangier">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_Fstr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Fstr_Zug_Rangier"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verlinkung, zu welcher Fahrstraße der PZB-Gleismagnet gehört (wird nur angegeben, wenn Ziel der Fahrstraße nicht identisch mit zugeordneten Signal ist oder Umfahrwege existieren). Dabei ist festgelegt, dass der Fahrweg der Fahrstraße über den PZB-Gleismagneten führt. Gleismagnete ohne Zuordnung zu einem Signal oder einer Fahrstraße sind ständig wirksam. Zur Verdeutlichung dienen die folgenden Beispiele: Media:Skizze PZB.pdf, Media:Tabellen PZB.pdf. In den Beipielen ist das PZB Element ein Gleismagnet 500 Hz; diese Verfahrensweise kann analog auch für alle anderen PZB_Elemente, z.B. GÜ, angewandt werden. DB-Regelwerk Gleismagnettabelle 1 mittels Fußnote &quot;}</rdfs:comment>
        <rdfs:label>ID_Fstr_Zug_Rangier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_Fstr#Wirksamkeit_Fstr -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_Fstr#Wirksamkeit_Fstr">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_Fstr"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCWirksamkeit_Fstr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, ob der Gleismagnet/ die GÜ bei Einstellung der referenzierten Fahrstraße wirksam ist oder nicht. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk Gleismagnettabelle&quot;}</rdfs:comment>
        <rdfs:label>Wirksamkeit_Fstr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_INA#ID_Anhang_INA -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_INA#ID_Anhang_INA">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_INA"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Anhang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die zugehörigen Dokumente zur INA-Berechnung. Dazu gehören Erhebungsbogen, Wirkbereichsbogen und ggf. die Berechnungsblätter selbst. Diese werden für jedes Signal gesondert erstellt. DB-Regelwerk 819.1310A02 &quot;}</rdfs:comment>
        <rdfs:label>ID_Anhang_INA</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_INA#ID_Bahnsteig_Kante -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_INA#ID_Bahnsteig_Kante">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Element_Zuordnung_INA"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bahnsteig_Kante"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;ID der zugehörigen Bahnsteigkante bezogen auf ein Signal mit INA-Berechnung. Der Fall, dass zwei separate Bahnsteige zwischen Vor- und Hauptsignal angeordnet sind, wird nicht angenommen. Aus der bisherigen Praxis sind keine solchen Fälle bekannt. DB-Regelwerk 819.1310A02 2 (1) &quot;}</rdfs:comment>
        <rdfs:label>ID_Bahnsteig_Kante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CPZB_Zuordnung_Signal#ID_PZB_Element_Zuordnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CPZB_Zuordnung_Signal#ID_PZB_Element_Zuordnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CPZB_Zuordnung_Signal"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_PZB_Element_Zuordnung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Objekt PZB_Element_Zuordnung, zur Angabe des zugehörigen Signals. &quot;}</rdfs:comment>
