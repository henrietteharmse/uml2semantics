        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnzahl_Verseilelemente"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Anzahl der Verseilelemente. Bsp.: 3x4x1,4.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..200]&quot;}</rdfs:comment>
        <rdfs:label>Anzahl_Verseilelemente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CKabel_Element#Verseilart -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CKabel_Element#Verseilart">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CKabel_Element"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVerseilart"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verseilart (4 = Viererverseilung; 1 = adrige Verseilung). Bsp.: 3x4x1,4.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1,4]&quot;}</rdfs:comment>
        <rdfs:label>Verseilart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CKabel_Element_Choice_1#Ader_Durchmesser -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CKabel_Element_Choice_1#Ader_Durchmesser">
