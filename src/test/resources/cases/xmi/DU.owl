        <rdfs:comment>{&quot;Documentation&quot;:&quot;X-Wert der Raster-Koordinate zur Positionierung des bautechnischen Kreuzungsplans, der der BÜ-Planung zugrunde liegt.&quot;}</rdfs:comment>
        <rdfs:label>Pixel_Koordinate_X</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Kreuzungsplan_Koordinaten#Pixel_Koordinate_Y -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan_Koordinaten#Pixel_Koordinate_Y">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Kreuzungsplan_Koordinaten"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCPixel_Koordinate_Y"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Y-Wert der Raster-Koordinate zur Positionierung des bautechnischen Kreuzungsplans, der der BÜ-Planung zugrunde liegt.&quot;}</rdfs:comment>
        <rdfs:label>Pixel_Koordinate_Y</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Schnittstelle#BUE_Abhaengigkeit_Fue -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Schnittstelle#BUE_Abhaengigkeit_Fue">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBUE_Abhaengigkeit_Fue"/>
        <rdfs:label>BUE_Abhaengigkeit_Fue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Schnittstelle#BUE_Schnittstelle_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Schnittstelle#BUE_Schnittstelle_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg"/>
        <rdfs:label>BUE_Schnittstelle_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Schnittstelle#ID_Stellelement -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Schnittstelle#ID_Stellelement">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Stellelement"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Objekt Stellelement zur Zusammenfassung von Eigenschaften der Objekte BUE Schnittstelle, PZB Element, Schluesselsperre, Signal, W Kr Gsp Element. Das Stellelement enthält Informationen über den energetischen und logischen Anschluss der Objekte. Für das PZB Element ist der Verweis nur zu füllen, wenn das PZB_Element eine GÜ ist. DB-Regelwerk Bisher ohne eindeutige Darstellung &quot;}</rdfs:comment>
        <rdfs:label>ID_Stellelement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#BUE_Nachlaufzeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#BUE_Nachlaufzeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBUE_Nachlaufzeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Nachlaufzeit des BÜ. Eine Nachlaufzeit wird vorgesehen, um an mehrgleisigen BÜ nach der Ausschaltung des BÜ eine Mindestöffnungszeit für den kreuzenden Straßenverkehr einzuhalten, bevor der BÜ erneut wieder eingeschaltet wird. Die Nachlaufzeit wirkt unmittelbar bei manueller Einschaltung durch den Fahrdienstleiter oder fahrstraßenbewirkter Einschaltung. DB-Regelwerk Einschaltstreckenberechnung &quot;,&quot;Patternbeschreibung&quot;:&quot;[0.00..n] zwei Stellen nach dem Komma &quot;,&quot;Patternbeschreibung_Abweichend&quot;:&quot; [0.00..99999.99] zwei Stellen nach dem Komma &quot;}</rdfs:comment>
        <rdfs:label>BUE_Nachlaufzeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#BUE_Vorlaufzeit -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#BUE_Vorlaufzeit">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBUE_Vorlaufzeit"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Vorlaufzeit des BÜ. Eine Vorlaufzeit wird vorgesehen, um an mehrgleisigen BÜ nach der Ausschaltung des BÜ eine Mindestöffnungszeit für den kreuzenden Straßenverkehr einzuhalten, bevor der BÜ erneut wieder eingeschaltet wird. Sie wird bei zugbewirkter Einschaltung vorgesehen und durch die Vorverlegung des Einschaltkontaktes erzwungen. Die sich daraus ergebene Verzögerungszeit wird als \&quot;Vorlaufzeit\&quot; bezeichnet. Damit verbunden ist der Nachteil, dass der BÜ zu früh eingeschaltet wird, wenn keine Zugbegegnung stattfindet. DB-Regelwerk Einschaltstreckenberechnung &quot;,&quot;Patternbeschreibung&quot;:&quot;[0.00..n] zwei Stellen nach dem Komma &quot;,&quot;Patternbeschreibung_Abweichend&quot;:&quot; [0.00..99999.99] zwei Stellen nach dem Komma &quot;}</rdfs:comment>
        <rdfs:label>BUE_Vorlaufzeit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#Hp_Ersatzstecker -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#Hp_Ersatzstecker">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCHp_Ersatzstecker"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Stecker, der die Betriebsart des zugehörigen Stellteils bestimmt. Bei vorbereiteten BÜ-Abhängigkeiten im Stellwerk, ohne dass die Außenanlage des BÜ vorhanden ist, kann mittels Ersatzstecker für das Stellwerk die Abhängigkeit zum BÜ aufgehoben werden. DB-Regelwerk Das Planungsdatum ist im Regelwerk der DB AG nicht enthalten. Die Anwendung ist mit allen Beteiligten projektbezogen abzustimmen.&quot;,&quot;ProposedValue&quot;:&quot;Abhaengigkeit_aufgehoben&quot;}</rdfs:comment>
        <rdfs:label>Hp_Ersatzstecker</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#LFUE_Impuls -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg#LFUE_Impuls">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Schnittstelle_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLFUE_Impuls"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Art des Impulses bei vorhandener Ladefernüberwachung. In Abhängigkeit vom Hersteller der BÜSA und vom Stellwerkstyp kann eine Ladefernüberwachung der BÜ-Batterie über die Hp- oder Fü-Schnittstelle erfolgen. Das Attribut ist anzulegen, wenn die BÜSA die technische Möglichkeit bietet. DB-Regelwerk Das Regelwerk der DB AG enthält keine entsprechende Vorgabe. Ob eine Ladefernüberwachung möglich ist, geht aus den Projektierungsrichtlinien der BÜ-Hersteller hervor.&quot;}</rdfs:comment>
        <rdfs:label>LFUE_Impuls</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal#ID_Signal -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal#ID_Signal">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Signal"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das Signal, welches im Zusammenhang mit dem BÜ angeordnet wird. Es ist zu unterscheiden, ob das Signal zur BUE Anlage (z. B. ÜS, Pfeiftafel) oder zur BUE Einschaltung (z. B. Merktafel) gehört.&quot;}</rdfs:comment>
        <rdfs:label>ID_Signal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal_Choice_1#ID_BUE_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal_Choice_1#ID_BUE_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_BUE_Anlage"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die BUE Anlage, für die das Signal angeordnet wird. &quot;}</rdfs:comment>
        <rdfs:label>ID_BUE_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal_Choice_1#ID_BUE_Einschaltung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal_Choice_1#ID_BUE_Einschaltung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_Spezifisches_Signal_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_BUE_Einschaltung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die BUE_Einschaltung, an der das Signal angeordnet wird (z.B. Tafel für die Markierung des Einschaltkontaktes). DB-Regelwerk SPU (Sammlung der Planunterlagen) 24 &quot;}</rdfs:comment>
        <rdfs:label>ID_BUE_Einschaltung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_WS_Fstr_Zuordnung#ID_BUE_Einschaltung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_WS_Fstr_Zuordnung#ID_BUE_Einschaltung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_WS_Fstr_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_BUE_Einschaltung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf denjenigen Einschaltpunkt, für den die Wirksamschaltung vorgesehen wird. DB-Regelwerk Einschaltstreckenberechnung &quot;}</rdfs:comment>
        <rdfs:label>ID_BUE_Einschaltung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_WS_Fstr_Zuordnung#ID_Fstr_Zug_Rangier -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_WS_Fstr_Zuordnung#ID_Fstr_Zug_Rangier">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBUE_WS_Fstr_Zuordnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Fstr_Zug_Rangier"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zeiger auf die Fahrstraße, für die die Einschaltung des BÜ abhängig geschaltet wird. DB-Regelwerk Datenblatt für die Abhängigkeiten BÜ - Stw &quot;}</rdfs:comment>
        <rdfs:label>ID_Fstr_Zug_Rangier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Anlage#Bezeichnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Anlage#Bezeichnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Anlage"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Anlage_Bezeichnung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Attributgruppe zur Bezeichnung von Stell- und sonstigen Elementen. Sofern ausreichend, wird an dieser Stelle über Vererbung die Basisattributgruppe Bezeichnung Element eingebunden. Ist die Abbildung mit den Attributen der Basisattributgruppe nicht möglich (z. B. wegen spezieller Patternvorgabe) oder nicht sinnvoll (z. B. weil eine Unterscheidung nach Bezeichnung_Lageplan_..., Bezeichnung_Tabelle und Bezeichnung_Aussenanlage (Pflichtattribute!) nicht notwendig ist), werden in der Attributgruppe Bezeichnung entsprechende objektspezifische Bezeichnungsattribute modelliert. Diese sind nach dem Schema Bezeichnung_[Objektname] zu benennen. Zudem ist es möglich, gleichzeitig die Basisattributgruppe Bezeichnung Element und objektspezifische Attribute einzubinden. Siehe auch Bildung der Bezeichnungen. DB-Regelwerk Sicherungstechnischer Lage- und Übersichtsplan, BÜ-Lageplan Planungstabellen &quot;}</rdfs:comment>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Anlage_Bezeichnung#Bezeichnung_Bahnsteig_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Anlage_Bezeichnung#Bezeichnung_Bahnsteig_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Anlage_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBezeichnung_Bahnsteig_Anlage"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bezeichnung der Bahnsteig_Anlage. Die Bezeichnung des Bahnsteigs muss nicht vergeben werden. Meist setzt sie sich aus dem Namen der beteiligten Bahnsteigkanten (z. B. \&quot;Bahnsteig 3/4\&quot;) zusammen, gelegentlich kann sie aber auch einen eigenen Namen bekommen (z. B. \&quot;Bahnsteig A\&quot; mit den Gleisen 102 und 103). Die folgende Grafik zeigt beispielhaft die Bezeichnung eines Mitelbahnsteigs mit anschließendem Zungenbahnsteig (zwei Bahnsteig-Anlagen mit jeweils zwei Bahnsteig-Kanten). &quot;}</rdfs:comment>
        <rdfs:label>Bezeichnung_Bahnsteig_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Dach#ID_Bahnsteig_Kante -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Dach#ID_Bahnsteig_Kante">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Dach"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bahnsteig_Kante_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die Bahnsteigkante, zu der die Überdachung gehört.&quot;}</rdfs:comment>
        <rdfs:label>ID_Bahnsteig_Kante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Kante#Bahnsteig_Kante_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Kante#Bahnsteig_Kante_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante_Allg"/>
        <rdfs:label>Bahnsteig_Kante_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Kante#Bezeichnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Kante#Bezeichnung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante_Bezeichnung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Attributgruppe zur Bezeichnung von Stell- und sonstigen Elementen. Sofern ausreichend, wird an dieser Stelle über Vererbung die Basisattributgruppe Bezeichnung Element eingebunden. Ist die Abbildung mit den Attributen der Basisattributgruppe nicht möglich (z. B. wegen spezieller Patternvorgabe) oder nicht sinnvoll (z. B. weil eine Unterscheidung nach Bezeichnung_Lageplan_..., Bezeichnung_Tabelle und Bezeichnung_Aussenanlage (Pflichtattribute!) nicht notwendig ist), werden in der Attributgruppe Bezeichnung entsprechende objektspezifische Bezeichnungsattribute modelliert. Diese sind nach dem Schema Bezeichnung_[Objektname] zu benennen. Zudem ist es möglich, gleichzeitig die Basisattributgruppe Bezeichnung Element und objektspezifische Attribute einzubinden. Siehe auch Bildung der Bezeichnungen. DB-Regelwerk Sicherungstechnischer Lage- und Übersichtsplan, BÜ-Lageplan Planungstabellen &quot;}</rdfs:comment>
        <rdfs:label>Bezeichnung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Kante#ID_Bahnsteig_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Kante#ID_Bahnsteig_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bahnsteig_Anlage"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zuordnung einer Bahnsteigkante oder eines Bahnsteigzugangs zu einer Bahnsteiganlage. DB-Regelwerk Zusammenhang wird aus der Darstellung im sicherungstechnischen Lageplan ersichtlich&quot;}</rdfs:comment>
        <rdfs:label>ID_Bahnsteig_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Kante_Allg#Lage_Zum_Gleis -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Kante_Allg#Lage_Zum_Gleis">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLage_Zum_Gleis"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Lage der Bahnsteig Kante zur Gleisachse bezogen auf die Richtung des Bereich Objekt. Siehe auch Modellierung Richtung. DB-Regelwerk Darstellung im sicherungstechnischen Lageplan&quot;}</rdfs:comment>
        <rdfs:label>Lage_Zum_Gleis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Kante_Allg#Systemhoehe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Kante_Allg#Systemhoehe">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCSystemhoehe"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Höhe der Bahnsteigoberkante am Gleis, gemessen ab Schienenoberkante. Bahnsteige werden in folgenden Systemhöhen (in cm) errichtet: 38 cm: niedrigste zulässige Höhe; 55 cm: Zwischenhöhe; 76 cm: Regelhöhe; 96 cm: größte zulässige Höhe (nur für ausschließlich dafür vorgesehene S-Bahnfahrzeuge); Sonderhoehe: Abweichende Höhen sind möglich, vor allem ältere Bahnsteigkanten können auch andere Höhen aufweisen. Bei Bahnsteigkanten mit mehreren Höhen wird die Höhe angegeben, an der der Schwerpunkt des Reisendenzustiegs liegt. DB-Regelwerk Bestandteil der betrieblichen Aufgabenstellung, ggf. Erwähnung im Erläuterungsbericht&quot;,&quot;PlanningStage&quot;:&quot;EP&quot;}</rdfs:comment>
        <rdfs:label>Systemhoehe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Kante_Bezeichnung#Bezeichnung_Bahnsteig_Kante -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Kante_Bezeichnung#Bezeichnung_Bahnsteig_Kante">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Kante_Bezeichnung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBezeichnung_Bahnsteig_Kante"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bezeichnung der Bahnsteig Kante. Die Bezeichnung der Bahnsteigkante ist für die LST-Planung relevant und muss vergeben werden. In verkehrlichen Unterlagen wird der Name unter \&quot;Gleis\&quot; bekanntgegeben, worauf im Datenmodell verzichtet wird, da hier \&quot;Gleis\&quot; im betrieblichen Sinne verwendet wird. Bezeichnungsbeispiel siehe Bezeichnung Bahnsteig Anlage. &quot;}</rdfs:comment>
        <rdfs:label>Bezeichnung_Bahnsteig_Kante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Zugang#Bahnsteig_Zugang_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Zugang#Bahnsteig_Zugang_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Zugang"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Zugang_Allg"/>
        <rdfs:label>Bahnsteig_Zugang_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Zugang#ID_Bahnsteig_Anlage -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Zugang#ID_Bahnsteig_Anlage">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Zugang"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bahnsteig_Anlage"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Zuordnung einer Bahnsteigkante oder eines Bahnsteigzugangs zu einer Bahnsteiganlage. DB-Regelwerk Zusammenhang wird aus der Darstellung im sicherungstechnischen Lageplan ersichtlich&quot;}</rdfs:comment>
        <rdfs:label>ID_Bahnsteig_Anlage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Zugang_Allg#Bahnsteig_Zugang_Art -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Zugang_Allg#Bahnsteig_Zugang_Art">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Zugang_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBahnsteig_Zugang_Art"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Art des Zugangs zum Bahnsteig. Das Attribut dient nur dazu, im INA-Erhebungsbogen die Zugänge zum Bahnsteig grob zu unterscheiden. DB-Regelwerk Eintrag im INA-Erhebungsbogen&quot;}</rdfs:comment>
        <rdfs:label>Bahnsteig_Zugang_Art</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBahnsteig_Zugang_Allg#Hauptzugang -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBahnsteig_Zugang_Allg#Hauptzugang">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBahnsteig_Zugang_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCHauptzugang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe, ob der Bahnsteig Zugang ein Hauptzugang ist (true) oder noicht (false). Die Angabe ist für die INA-Berechnung relevant. Je Bahnsteig Anlage darf nur ein Hauptzugang bestimmt werden. DB-Regelwerk Eintrag im INA-Erhebungsbogen&quot;,&quot;ProposedValue&quot;:&quot;false&quot;}</rdfs:comment>
        <rdfs:label>Hauptzugang</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise#Balise_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise#Balise_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:label>Balise_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise#ID_Datenpunkt -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise#ID_Datenpunkt">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Datenpunkt_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den Datenpunkt, zu dem die Balise gehört. Die maximale Anzahl von 16 Balisen für einen Datenpunkt ergibt sich aus der Möglichkeit duplizierter Balisen.&quot;}</rdfs:comment>
        <rdfs:label>ID_Datenpunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise_Allg#Anordnung_Im_DP -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise_Allg#Anordnung_Im_DP">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAnordnung_Im_DP"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[1..16]&quot;,&quot;Documentation&quot;:&quot;Physische Anordnung der Balise im Datenpunkt. Die Balise mit der Nummer 1 ist die Referenzbalise des Datenpunkts. Duplizierte Balisen werden mitgezählt.&quot;}</rdfs:comment>
        <rdfs:label>Anordnung_Im_DP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise_Allg#Balise_Geraetestand -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise_Allg#Balise_Geraetestand">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBalise_Geraetestand"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Gerätestand der Balise. Die Information ist im Zusammenhang mit der Typ-Angabe im Attribut \&quot;Fabrikat\&quot; zu interpretieren. Beispiel: 3, 12a.&quot;}</rdfs:comment>
        <rdfs:label>Balise_Geraetestand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise_Allg#Balisenhalter -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise_Allg#Balisenhalter">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBalisenhalter"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Art des verwendeten Balisenhalters, z. B. Vortok. Die Erfassung erfolgt gegenwärtig auf der Baustelle (Rücklaufdatum).&quot;}</rdfs:comment>
        <rdfs:label>Balisenhalter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise_Allg#Fabrikat -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise_Allg#Fabrikat">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCFabrikat"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Herstellerbezogene Bezeichnung bzw. Typ-Angabe (Rücklaufdatum). Beispiel: S21 (Siemens).&quot;}</rdfs:comment>
        <rdfs:label>Fabrikat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise_Allg#Hersteller -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise_Allg#Hersteller">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCHersteller"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Unternehmen, das die Funktionsfähigkeit der Anlage verantwortlich hergestellt hat oder Hersteller des jeweiligen Elements. Diese Eigenschaft ist kein Datum einer Planung, sondern dient im Rücklauf der Planung dazu den Hersteller im Bestand zu erfassen. Es ist die zum Zeitpunkt der Inbetriebnahme gültige Firmierung zu verwenden. DB-Regelwerk Beschreibung im Erläuterungsbericht&quot;}</rdfs:comment>
        <rdfs:label>Hersteller</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise_Allg#Hinweis_Balisenbefestigung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise_Allg#Hinweis_Balisenbefestigung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCHinweis_Balisenbefestigung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Hinweis auf Besonderheiten bei der Balisenbefestigung, z. B. Längsbefestigung.&quot;}</rdfs:comment>
        <rdfs:label>Hinweis_Balisenbefestigung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBalise_Allg#Montageabweichung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBalise_Allg#Montageabweichung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBalise_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCMontageabweichung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abweichung vom geplanten Standort der Balise bei der Montage im Rahmen der zulässigen Toleranz.&quot;}</rdfs:comment>
        <rdfs:label>Montageabweichung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasisAttribut#ID_Bearbeitungsvermerk -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasisAttribut#ID_Bearbeitungsvermerk">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasisAttribut"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bearbeitungsvermerk"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweist auf einen oder mehrere Bearbeitungsvermerke. Ein Anhang wird über einen Bearbeitungsvermerk zugeordnet. 
&quot;}</rdfs:comment>
        <rdfs:label>ID_Bearbeitungsvermerk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt#Basis_Objekt_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt#Basis_Objekt_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt_Allg"/>
        <rdfs:label>Basis_Objekt_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt#ID_Bearbeitungsvermerk -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt#ID_Bearbeitungsvermerk">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Bearbeitungsvermerk"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweist auf einen oder mehrere Bearbeitungsvermerke. Ein Anhang wird über einen Bearbeitungsvermerk zugeordnet. &quot;}</rdfs:comment>
        <rdfs:label>ID_Bearbeitungsvermerk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt#ID_Oertlichkeit_Ausgabe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt#ID_Oertlichkeit_Ausgabe">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Oertlichkeit_Ausgabe"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die Oertlichkeit (Betriebsstelle), der das Element zugeordnet wird. Die Angabe ist beispielsweise relevant für die Erzeugung der Ausgabeformate (Lagepläne, Tabellen).&quot;}</rdfs:comment>
        <rdfs:label>ID_Oertlichkeit_Ausgabe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt#Objektreferenzen -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt#Objektreferenzen">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CObjektreferenzen"/>
        <rdfs:label>Objektreferenzen</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt_Allg#Bestandsschutz -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt_Allg#Bestandsschutz">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBestandsschutz"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Für das betroffene Objekt wurde Bestandsschutz festgelegt (true). Die Angabe entfällt, wenn kein Bestandsschutz vorhanden ist.&quot;}</rdfs:comment>
        <rdfs:label>Bestandsschutz</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt_Allg#Objektzustand_Besonders -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt_Allg#Objektzustand_Besonders">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCObjektzustand_Besonders"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Besonderer Zustand eines Objekts im Planungsbereich. Ist dieses Attribut nicht vorhanden, so ist das Objekt am geplanten/vorgesehenen Standort und angesteuert. \&quot;Nicht gültig\&quot; sind gemäß Betra als nicht gültig erklärte Signale im Baugleis [gem. Ril 819.1701 (11)]. \&quot;Ungültig\&quot; sind betrieblich außer Betrieb befindliche Signale, die mit einem Ungültigkeitskreuz [gem. Ril 819.1701 (10)] versehen sind. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. DB-Regelwerk Bisher keine eindeutige Abbildung, besonderer Objektzustand meist Fußnoteneintrag in Planungsunterlagen.&quot;}</rdfs:comment>
        <rdfs:label>Objektzustand_Besonders</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt_Choice_1#Datum_Regelwerk -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt_Choice_1#Datum_Regelwerk">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDatum_Regelwerk"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Datum des letzten Planungsstandes eines Objekts, Hinweis auf den Regelwerksstand zum Planungszeitpunkt. Ergänzende Beschreibung zum Umgang im PlanPro-Planungsprozess Anhand des Regelwerksstandes lassen sich die jeweils gültigen Stände der verwendeten Regelwerke herleiten (wichtig für Bestandsschutz). Abweichungen werden auf Objektebene (Basis Objekt) über das Attribut ID Anhang Regelwerk Besonders beigefügt. Im Rahmen der Erstellung einer Planung_Einzel werden alle neuen und geänderten Objekte standardmäßig mit dem zentral einzugebenden Wert des Attributs „Datum Regelwerksstand“ der Planung_Einzel befüllt. Durch die Befüllung dürfen bereits vorhandene Angaben „ID_Anhang_Regelwerk_Besonders“ nicht überschrieben werden. Bei Abweichungen kann der LST-Fachplaner objekt- oder objektgruppenbezogen „ID_Anhang_Regelwerk_Besonders“ füllen. DB-Regelwerk Bisher ohne eindeutige Abbildung im Schriftfeld gemäß Ril 886.0102. &quot;}</rdfs:comment>
        <rdfs:label>Datum_Regelwerk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBasis_Objekt_Choice_1#ID_Anhang_Regelwerk_Besonders -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBasis_Objekt_Choice_1#ID_Anhang_Regelwerk_Besonders">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt_Choice_1"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Anhang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Für das Objekt abweichend geltendes Regelwerk. Verweis auf einen Anhang, aus dem der besondere Regelwerksstand eines LST-Objektes hervorgeht. Dieser gilt abweichend von dem für die Planung_Einzel festgelegten Datum Regelwerksstand. Ergänzende Beschreibung zum Umgang im PlanPro-Planungsprozess Im Schriftfeld gemäß Ril 886.0102 dient Feld 30 \&quot;Zusätzliche Vermerke\&quot; üblicherweise zur Angabe von Regelwerksabweichungen. DB-Regelwerk Bisher eine eindeutige Abbildung als Schriftfeldeintrag gemäß Ril 886.0102. Meist Angabe im Erläuterungsbericht. &quot;}</rdfs:comment>
        <rdfs:label>ID_Anhang_Regelwerk_Besonders</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk#Bearbeitungsvermerk_Allg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk#Bearbeitungsvermerk_Allg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg"/>
        <rdfs:label>Bearbeitungsvermerk_Allg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk#ID_Anhang -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk#ID_Anhang">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Anhang"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den durch diesen Bearbeitungsvermerk referenzierten Anhang.&quot;}</rdfs:comment>
        <rdfs:label>ID_Anhang</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#BV_Darstellung_In_Plan -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#BV_Darstellung_In_Plan">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBV_Darstellung_In_Plan"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Angabe des Plans, in dem der Bearbeitungsvermerk dargestellt werden soll.&quot;}</rdfs:comment>
        <rdfs:label>BV_Darstellung_In_Plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#BV_Kategorie -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#BV_Kategorie">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBV_Kategorie"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Kategorisierung des Bearbeitungsvermerks zur Sortierung und Filterung (z. B. zur Ablage von Zusatzinformationen für besondere Anwendungsfälle)&quot;}</rdfs:comment>
        <rdfs:label>BV_Kategorie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Bearbeitungsvermerk_Rolle -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Bearbeitungsvermerk_Rolle">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBearbeitungsvermerk_Rolle"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Fachliche Rolle des Bearbeiters, der den Bearbeitungsvermerk verfasst hat. In der ersten Umsetzungsstufe PlanPro ist dabei nur die Rolle \&quot;LST_Fachplaner\&quot; (Ingenieurbüro) vorgesehen. Bei Auswahl von \&quot;sonstige\&quot; ist ein Bearbeitungsvermerk mit entsprechenden Erläuterungen anzufügen. &quot;}</rdfs:comment>
        <rdfs:label>Bearbeitungsvermerk_Rolle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Bestandsrelevanz -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Bestandsrelevanz">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBestandsrelevanz"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Relevanz eines Bearbeitungsvermerks für die Übernahme in den Bestand (Bestandsdaten bzw. Bestandspläne).
nein - Nur gültig innerhalb einer Planungsgruppe. Der BV ist vor Erstellen der Bestandsdaten einer Planungsgruppe zu löschen.
Bestandsdaten - Gültig innerhalb eines Planungsprojekts bis vor Erstellen einer Bestandsdokumentation, d. h. der BV kann in den Bestandsdaten enthalten bleiben, ist jedoch vor Erstellen einer Bestandsdokumentation zu löschen.
Bestandsdokumentation - Gültig innerhalb eines Planungsprojekts bis vor Erstellen der letzten Bestandsdokumentation, d. h. der BV kann über mehrere Planungsgruppen hinaus enthalten bleiben, ist jedoch vor Projektabschluss zu löschen.
dauerhaft - Gültig über das Gesamtprojekt hinaus auch nach Erstellen der letzten Bestandsdokumentation.
Der BV ist dauerhaft relevant und kann erst mit einem neuen Planungsprojekt  geändert/gelöscht werden.&quot;}</rdfs:comment>
        <rdfs:label>Bestandsrelevanz</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Kommentar -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Kommentar">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKommentar"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Kommentare des Bearbeiters als Freitext.&quot;}</rdfs:comment>
        <rdfs:label>Kommentar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Kurztext -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Kurztext">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKurztext"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Kurzform des Kommentars des Bearbeitungsvermerks f&amp;#252;r Anzeige bzw. Druck in den Ausgabeformaten.&quot;}</rdfs:comment>
        <rdfs:label>Kurztext</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBearbeitungsvermerk_Allg#Zeit_Bearbeitungsvermerk -->


