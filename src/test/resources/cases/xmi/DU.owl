        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDP_Typ_GESG"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLfd_Nr_Am_Bezugspunkt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Laufende Nummer, wenn zu einem betrieblichen Bezugspunkt mehrere Datenpunkte des gleichen Typs gehören.&quot;}</rdfs:comment>
        <rdfs:label>Lfd_Nr_Am_Bezugspunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDP_Typ_GETCS#DP_ATO -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDP_Typ_GETCS#DP_ATO">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDP_Typ_GETCS"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDP_ATO"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verwendungsart des Datenpunkt(typ)s bei Nutzung für ATO. Das Attribut kann die Werte \&quot;Präzisionshalt\&quot;, \&quot;Präzisionshalt hochpräzise\&quot; (mit besonderen Anforderungen hinsichtlich Platzierung und Einmessung) und \&quot;sonstige\&quot; (sonstige Funktion für ATO, die mittels Bearbeitungsvermerk zu erläutern ist) annehmen. Hat der Datenpunkt(typ) für ATO keinerlei Funktion, entfällt das Attribut.&quot;}</rdfs:comment>
        <rdfs:label>DP_ATO</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDP_Typ_GETCS#DP_Typ_ETCS -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDP_Typ_GETCS#DP_Typ_ETCS">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDP_Typ_GETCS"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDP_Typ_ETCS"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[1..99]&quot;,&quot;Documentation&quot;:&quot;Durch das Anwendungssystem ETCS definierter Datenpunkttyp. Bei zusammengefassten Datenpunkttypen erfolgt eine mehrfache Angabe.&quot;}</rdfs:comment>
        <rdfs:label>DP_Typ_ETCS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDP_Typ_GETCS#ID_DP_Bezug_Funktional -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDP_Typ_GETCS#ID_DP_Bezug_Funktional">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDP_Typ_GETCS"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_DP_Bezug_Funktional"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Element, auf das sich der fachliche Inhalt des Datenpunkts bezieht. Der fachliche Bezug kann Vorgaben für die Positionierung des Datenpunkts beinhalten. Die Angabe ist nur erforderlich, sofern sich dieser Punkt nicht über eine zugehörige LEU-Anlage ermittelt werden kann bzw. soll. Große Metallteile werden über ZUB_Streckeneigenschaft abgebildet. Bei ETCS L2 erfolgt die Angabe des Bezugspunkts im Zuammenhang mit dem DP-Typ.&quot;}</rdfs:comment>
        <rdfs:label>ID_DP_Bezug_Funktional</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDP_Typ_GETCS#Verkuerzter_Abstand -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDP_Typ_GETCS#Verkuerzter_Abstand">
