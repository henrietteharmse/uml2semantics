        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_BUE_Gleisbezogener_Gefahrraum"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den zugehörigen Gefahrraum, auf den sich die BUE_Einschaltung - gleisbezogen - bezieht. &quot;}</rdfs:comment>
        <rdfs:label>ID_BUE_Gleisbez_Gefahrraum</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBUE_Gefahrraum_Eckpunkt#Bezeichnung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CBUE_Gefahrraum_Eckpunkt#Bezeichnung">
