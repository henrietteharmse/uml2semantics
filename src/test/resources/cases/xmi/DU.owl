    <!-- https://uml2semantics.com/ontology/CAkteur -->


    <owl:Class rdf:about="https://uml2semantics.com/ontology/CAkteur">
        <rdfs:subClassOf rdf:resource="https://uml2semantics.com/ontology/CUr_Objekt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CAkteur#Akteur_Allg"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CAkteur#Kontaktdaten"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>{&quot;ObjectType&quot;:&quot;LST_OBJECT&quot;,&quot;Documentation&quot;:&quot;Am PlanPro-Planungsprozess beteiligter Akteur.
In PlanPro werden der Name und Kontaktdaten des Akteurs erfasst. Einschränkungen hinsichtlich der zulässigen Rolle des Akteurs sind durch entsprechende Attributbezeichnungen und -beschreibungen ersichtlich.
DB-Regelwerk Schriftfeldeintrag gemäß Ril 886.0102&quot;}</rdfs:comment>
        <rdfs:label>CAkteur</rdfs:label>
    </owl:Class>
    


    <!-- https://uml2semantics.com/ontology/CAkteur_Allg -->


