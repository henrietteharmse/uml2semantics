    <!-- https://uml2semantics.com/ontology/CESTW_Zentraleinheit -->


    <owl:Class rdf:about="https://uml2semantics.com/ontology/CESTW_Zentraleinheit">
        <rdfs:subClassOf rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://uml2semantics.com/ontology/CESTW_Zentraleinheit#Bezeichnung"/>
