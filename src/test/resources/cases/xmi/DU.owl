    <!-- https://uml2semantics.com/ontology/CFT_Fahrweg_Teil -->


    <owl:Class rdf:about="https://uml2semantics.com/ontology/CFT_Fahrweg_Teil">
        <rdfs:subClassOf rdf:resource="https://uml2semantics.com/ontology/CBasis_Objekt"/>
        <rdfs:subClassOf>
