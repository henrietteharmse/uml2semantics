        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_ZN_Anzeigefeld"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf das ZN Anzeigefeld in der Bedienoberfläche, in das die Zugnummer fortgeschaltet wird. Die Angabe erfolgt nur bei besonderen Schaltkriterien. Eine Fortschaltung ist in mehrere Richtungen möglich.&quot;}</rdfs:comment>
        <rdfs:label>ID_ZN_Fortschalt_Krit_Ziel</rdfs:label>
    </owl:ObjectProperty>
    


