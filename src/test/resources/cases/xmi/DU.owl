        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVerkuerzter_Abstand"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Bei DP 26: Angabe des Abstands, um den der Beginn der Langsamfahrstelle verkürzt wird. DB-Regelwerk Ril 819.1344, 4.1 (31)&quot;}</rdfs:comment>
        <rdfs:label>Verkuerzter_Abstand</rdfs:label>
    </owl:ObjectProperty>
    


