        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die Weichenlaufkette, in der das Weichenelement enthalten ist. &quot;}</rdfs:comment>
        <rdfs:label>ID_Weichenlaufkette</rdfs:label>
    </owl:ObjectProperty>
    


