        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf den Lageplan, zu dem der Lageplan-Zustand definiert wird.&quot;}</rdfs:comment>
        <rdfs:label>ID_Lageplan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLageplan_Zustand#Referenz_LST_Zustand -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLageplan_Zustand#Referenz_LST_Zustand">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLageplan_Zustand"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCReferenz_LST_Zustand"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;GUID des LST-Zustand, der für die Erstellung des Lageplans ausgewertet wird. Werden LST-Zustände einer Planung referenziert, müssen Sie einheitlich entweder den Start- oder den Zielzustand beschreiben. Eine Mischung von Start- und Zielzuständen ist nicht zulässig.&quot;}</rdfs:comment>
        <rdfs:label>Referenz_LST_Zustand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLieferobjekt#Beschreibung -->


