        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Ur_Objekt"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;ID-Verweis auf LST-Objekt im Planungsbereich.
DB-Regelwerk
Bisher keine Abbildung, da Neuerung mit PlanPro.
Implizite Zuordnung durch Blattzuschnitte der (gesperrten) Bestandspläne zur Erstellung der Planung.&quot;}</rdfs:comment>
        <rdfs:label>ID_LST_Objekt_Planungsbereich</rdfs:label>
    </owl:ObjectProperty>
    


