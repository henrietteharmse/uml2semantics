    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CDatenpunkt#ID_RBC">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CDatenpunkt"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_RBC"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Verweis auf die RBC, denen der Datenpunkt bekannt ist.&quot;}</rdfs:comment>
        <rdfs:label>ID_RBC</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CDatenpunkt#LEU_Steuernde -->


