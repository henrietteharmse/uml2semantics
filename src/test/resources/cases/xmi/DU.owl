        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CFachdaten"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Einbindung der LST-Fachdaten.
DB Regelwerk
Bisher keine Abbildung, da Neuerung mit PlanPro-Planungsprozess.&quot;}</rdfs:comment>
        <rdfs:label>Fachdaten</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLST_Planung#Objektmanagement -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLST_Planung#Objektmanagement">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLST_Planung"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CObjektmanagement"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Einbindung der Objektmanagementdaten.
DB Regelwerk
Bisher keine Abbildung, da Neuerung mit PlanPro-Planungsprozess.&quot;}</rdfs:comment>
        <rdfs:label>Objektmanagement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLST_Zustand#Anhang_LST_Zustand -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLST_Zustand#Anhang_LST_Zustand">
