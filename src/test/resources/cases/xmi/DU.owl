        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[0..31]&quot;,&quot;Documentation&quot;:&quot;Kodierung des Haltefensters am Halteplatz bei automatischer Fahrt (Q_Stop_Location Tolerance).&quot;}</rdfs:comment>
        <rdfs:label>Haltetoleranz</rdfs:label>
    </owl:ObjectProperty>
    


