        <rdfs:label>Bedingung_Weiche</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Abstand_Bes_Langer_Einfahrweg -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Abstand_Bes_Langer_Einfahrweg">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAbstand_Bes_Langer_Einfahrweg"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand vom Datenpunkt bis zur ersten im abzweigenden Strang befahrenen Weiche. Die explizite Angabe erfolgt, sofern keine topologische Ermittlung möglich ist. DB-Regelwerk ESG-Datenpunkttabelle 1, Spalte 24.&quot;}</rdfs:comment>
        <rdfs:label>Abstand_Bes_Langer_Einfahrweg</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#DP_Typ_V_La -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#DP_Typ_V_La">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDP_Typ_V_La"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[10..140]&quot;,&quot;Documentation&quot;:&quot;Geschwindigkeitsbeschränkung (ständige oder vorübergehende Langsamfahrstelle bzw. Vorsignalisierung), die durch den Datenpunkt angekündigt wird (Parameter -y).&quot;}</rdfs:comment>
        <rdfs:label>DP_Typ_V_La</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#ESG_Individuelle_Merkmale -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#ESG_Individuelle_Merkmale">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CESG_Individuelle_Merkmale"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Attributgruppe zur Angabe von angepassten Parametern bei individueller Projektierung, z. B. Datenpunkttyp BM mit Parameter für Länge der Metallmasse in Metern.&quot;}</rdfs:comment>
        <rdfs:label>ESG_Individuelle_Merkmale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#ESG_Spezifische_Merkmale -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#ESG_Spezifische_Merkmale">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CESG_Spezifische_Merkmale"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Attributgruppe zur Angabe von frei definierten Parametern bei spezifischer Projektierung.&quot;}</rdfs:comment>
        <rdfs:label>ESG_Spezifische_Merkmale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#ID_Massgebendes_Zielsignal -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#ID_Massgebendes_Zielsignal">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCID_Signal_ohne_Proxy"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Signalbezeichnung des restriktivsten Falls \&quot;Länge Vorsignalüberwachung je Signalisierung\&quot;.&quot;}</rdfs:comment>
        <rdfs:label>ID_Massgebendes_Zielsignal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Individualisierung_Weitere -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Individualisierung_Weitere">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCIndividualisierung_Weitere"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Beschreibung der  
weitergehenden Individualisierung, die nicht formal in den Parametern der Datenpunkttabelle 1 (Attributgruppe ESG_Individuelle_Merkmale)  abgebildet werden kann. DB-Regelwerk Ril 819.1348, 4 (36) - Erläuterungen zur Bemerkungsspalte&quot;}</rdfs:comment>
        <rdfs:label>Individualisierung_Weitere</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Laenge_Gestufte_V_Signalisierung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Laenge_Gestufte_V_Signalisierung">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCLaenge_Gestufte_V_Signalisierung"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Abstand vom Datenpunkt bis zum alleinstehenden Zs 3. Die explizite Angabe erfolgt, sofern keine topologische Ermittlung möglich ist. DB-Regelwerk ESG-Datenpunkttabelle 1, Spalte 24.&quot;}</rdfs:comment>
        <rdfs:label>Laenge_Gestufte_V_Signalisierung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#NID_TSR -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#NID_TSR">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCNID_TSR"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Nummer der Langsamfahrstelle (La). Bei Geschwindigkeitssignalisierung mittels Zs 3 erfolgt der Eintrag \&quot;0\&quot;. DB-Regelwerk ESG-Datenpunkttabelle 1, Spalte 21.&quot;}</rdfs:comment>
        <rdfs:label>NID_TSR</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Projektierungsfall -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Projektierungsfall">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCProjektierungsfall"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Projektierungsfall gemäß Ril 819.1348, 7.2&quot;}</rdfs:comment>
        <rdfs:label>Projektierungsfall</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Telegrammnummer -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Telegrammnummer">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCTelegrammnummer"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Nummer des Fachtelegramms als Referenz für das Linking.&quot;}</rdfs:comment>
        <rdfs:label>Telegrammnummer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Ueberwachung_Laenge -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#Ueberwachung_Laenge">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCUeberwachung_Laenge"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Länge des Vorsignalüberwachungsabschnitts, auf den sich das Fachtelegramm bezieht.&quot;}</rdfs:comment>
        <rdfs:label>Ueberwachung_Laenge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#V_Start -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_ESG_Merkmale#V_Start">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFT_ESG_Merkmale"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCV_Start"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Startgeschwindigkeit am Datenpunkt (bzw. Bezugspunkt) in km/h. DB-Regelwerk ESG-Datenpunkttabelle 1, Spalte 19.&quot;}</rdfs:comment>
        <rdfs:label>V_Start</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_ESG_Merkmale#V_Ziel -->


