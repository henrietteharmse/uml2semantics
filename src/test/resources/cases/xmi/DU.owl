        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CFMA_Anlage"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CFMA_Anlage_Elektr_Merkmale"/>
        <rdfs:label>FMA_Anlage_Elektr_Merkmale</rdfs:label>
    </owl:ObjectProperty>
    


