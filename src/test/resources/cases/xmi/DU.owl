    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CFT_Anschaltbedingung_Choice_1#Bedingung_Sonstige -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CFT_Anschaltbedingung_Choice_1#Bedingung_Sonstige">
