        <rdfs:label>Pruefmerkmale_Binaerdatei_Hilfe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLT_Binaerdatei_Hilfe#Verwendung_Hilfe -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLT_Binaerdatei_Hilfe#Verwendung_Hilfe">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CLT_Binaerdatei_Hilfe"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCVerwendung_Hilfe"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Herstellerübergreifend eindeutige Beschreibung des Verwendungszwecks der  Hilfsdatei (z. B. Kodierungsart, Steuerung des Prüf-Algorithmus).&quot;}
</rdfs:comment>
        <rdfs:label>Verwendung_Hilfe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLT_Binaerdaten#ID_Anhang_EA_Doku -->


