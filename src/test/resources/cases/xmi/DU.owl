        <rdfs:label>LO_DB_Freigabe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CLO_Material#LO_Datum_Herstellung -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/CLO_Material#LO_Datum_Herstellung">
