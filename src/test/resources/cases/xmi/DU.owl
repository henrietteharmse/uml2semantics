        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCBezeichnung_Schluessel"/>
        <rdfs:comment>{&quot;Patternbeschreibung&quot;:&quot;[1..20]&quot;,&quot;Documentation&quot;:&quot;Auf dem Schluessel angebrachte Bezeichnung.&quot;}</rdfs:comment>
