        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CZN_Fortschalt_Krit_Druck"/>
        <rdfs:label>ZN_Fortschalt_Krit_Druck</rdfs:label>
    </owl:ObjectProperty>
    


