        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDP_Typ_Art"/>
        <rdfs:comment>{&quot;ProposedValue&quot;:&quot;sekundaer&quot;,&quot;Documentation&quot;:&quot;Das angegebene Anwendungssystem ist das sekundär genutzte. Sofern keine Angabe vorhanden ist, handelt es sich um das einzige oder primaer genutzte Anwendungssystem.&quot;}</rdfs:comment>
        <rdfs:label>DP_Typ_Art</rdfs:label>
    </owl:ObjectProperty>
    


