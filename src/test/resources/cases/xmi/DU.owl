        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCAdresse_Strasse_Nr"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Adresse der Organisation, konkret Straße und Hausnummer. Alternativ ist auch die Eintragung des Postfachs möglich.
DB Regelwerk
Ggf. Bestandteil des Schriftfeldeintrages gemäß Ril 886.0102 zum mit der Planung beauftragten Ingenieurbüro.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..50]&quot;}</rdfs:comment>
        <rdfs:label>Adresse_Strasse_Nr</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/COrganisation#E_Mail_Adresse -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/COrganisation#E_Mail_Adresse">
        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/COrganisation"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCE_Mail_Adresse"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;E-Mail-Adresse der Organisation.
DB Regelwerk
Ggf. Bestandteil des Schriftfeldeintrages gemäß Ril 886.0102 zum mit der Planung beauftragten Ingenieurbüro.&quot;,&quot;Patternbeschreibung&quot;:&quot;[1..50@1..50] 50 Zeichen vor und nach dem @-Zeichen&quot;}</rdfs:comment>
        <rdfs:label>E_Mail_Adresse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/COrganisation#Name_Organisation -->


    <owl:ObjectProperty rdf:about="https://uml2semantics.com/ontology/COrganisation#Name_Organisation">
