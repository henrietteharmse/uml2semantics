        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCKm_BTS_3"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Streckenkilometer der dritten BTS, die an die Bereichsgrenze (RBC-Wechsel) angrenzt.&quot;}</rdfs:comment>
        <rdfs:label>Km_BTS_3</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBinaerdaten#Binaerdaten_Datei -->


