        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/TCDateiname"/>
        <rdfs:comment>{&quot;Documentation&quot;:&quot;Ursprünglicher Dateiname der Binaerdatei ohne Endung. Bei Verwendung für ein Lufttelegramm wird kein Dateiname vergeben.&quot;}</rdfs:comment>
        <rdfs:label>Dateiname</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://uml2semantics.com/ontology/CBinaerdaten_Datei#Dateityp_Binaerdatei -->


