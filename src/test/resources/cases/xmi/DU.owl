        <rdfs:domain rdf:resource="https://uml2semantics.com/ontology/CW_Kr_Gsp_Element"/>
        <rdfs:range rdf:resource="https://uml2semantics.com/ontology/CW_Kr_Gsp_Element_Allg"/>
